<% var name = locals.profileUser ? (profileUser.name || profileUser.username) + "'s Profile" : "Profile"; %>

<% if (locals.profileUser) { %>
<!-- ═══════════════════════════════════════════════════════════════════════════ -->
<!-- PUBLIC PROFILE VIEW: rendered at /u/:username                               -->
<!-- ═══════════════════════════════════════════════════════════════════════════ -->
<style>
    .pub-profile { max-width: 680px; margin: 0 auto; }
    .pub-hero { display: flex; align-items: flex-start; gap: 20px; padding: 22px; background: var(--form-bg-color); border: 1px solid var(--form-border-color); border-radius: 12px; margin-bottom: 20px; flex-wrap: wrap; }
    .pub-avatar { width: 72px; height: 72px; border-radius: 50%; object-fit: cover; border: 2px solid var(--form-border-color); flex-shrink: 0; background: var(--form-border-color); }
    .pub-avatar-placeholder { width: 72px; height: 72px; border-radius: 50%; background: var(--form-border-color); display: flex; align-items: center; justify-content: center; font-size: 28px; flex-shrink: 0; }
    .pub-info { flex: 1; }
    .pub-name { font-size: 20px; font-weight: 700; margin: 0 0 4px; }
    .pub-username { font-size: 13px; opacity: 0.5; margin: 0 0 8px; }
    .pub-bio { font-size: 14px; opacity: 0.75; margin: 0 0 10px; line-height: 1.5; }
    .pub-stats { display: flex; gap: 16px; font-size: 13px; }
    .pub-stats strong { display: block; font-size: 16px; font-weight: 700; }
    .pub-stat { text-align: center; }
    .pub-stat span { font-size: 11px; opacity: 0.55; }
    .pub-projects-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 12px; }
    .pub-proj-card { background: var(--form-bg-color); border: 1px solid var(--form-border-color); border-radius: 8px; padding: 14px; display: flex; flex-direction: column; gap: 6px; }
    .pub-proj-card h4 { margin: 0; font-size: 14px; }
    .pub-proj-card p { margin: 0; font-size: 12px; opacity: 0.65; }
    .follow-btn { padding: 7px 20px; border-radius: 20px; cursor: pointer; font-size: 14px; }
    .follow-btn.following { background: transparent; border: 1px solid var(--form-border-color); }
</style>

<div class="pub-profile">
    <div class="pub-hero">
        <% if (profileUser.avatar) { %>
            <img src="<%= profileUser.avatar %>" class="pub-avatar" alt="<%= profileUser.name %>">
        <% } else { %>
            <div class="pub-avatar-placeholder"><ion-icon name="person-circle-outline" aria-hidden="true"></ion-icon></div>
        <% } %>
        <div class="pub-info">
            <p class="pub-name"><%= profileUser.name || profileUser.username %></p>
            <% if (profileUser.username) { %><p class="pub-username">@<%= profileUser.username %></p><% } %>
            <% if (profileUser.bio) { %><p class="pub-bio"><%= profileUser.bio %></p><% } %>
            <div class="pub-stats">
                <div class="pub-stat">
                    <strong><%= profileUser.followers ? profileUser.followers.length : 0 %></strong>
                    <span>Followers</span>
                </div>
                <div class="pub-stat">
                    <strong><%= profileUser.following ? profileUser.following.length : 0 %></strong>
                    <span>Following</span>
                </div>
                <div class="pub-stat">
                    <strong><%= locals.projects ? projects.length : 0 %></strong>
                    <span>Projects</span>
                </div>
            </div>
        </div>
        <% if (!locals.isSelf && user) { %>
        <button class="follow-btn <%= locals.isFollowing ? 'following' : '' %>" id="followBtn"
                onclick="toggleFollow('<%= profileUser.username %>')">
            <%= locals.isFollowing ? 'Unfollow' : 'Follow' %>
        </button>
        <% } %>
        <% if (locals.isSelf) { %>
            <a href="/profile" style="font-size:13px; padding:7px 16px; border:1px solid var(--form-border-color); border-radius:6px; text-decoration:none; color:inherit;">Edit Profile</a>
        <% } %>
    </div>

    <% if (locals.projects && projects.length > 0) { %>
    <p style="font-size:12px; opacity:0.45; text-transform:uppercase; letter-spacing:0.06em; margin:0 0 10px;">Public Projects</p>
    <div class="pub-projects-grid">
        <% projects.forEach(function(p) { %>
        <div class="pub-proj-card" <% if (p.color) { %>style="border-left:4px solid <%= p.color %>;"<% } %>>
            <% if (p.color) { %><span style="width:8px;height:8px;border-radius:50%;background:<%= p.color %>;display:inline-block;"></span><% } %>
            <h4><%= p.name %></h4>
            <% if (p.description) { %><p><%= p.description.substring(0, 80) %><%= p.description.length > 80 ? '…' : '' %></p><% } %>
            <a href="/projects/<%= p._id %>" style="font-size:12px; color:inherit; text-decoration:none; opacity:0.6; margin-top:4px;">View →</a>
        </div>
        <% }) %>
    </div>
    <% } else { %>
    <p style="opacity:0.45; font-size:14px;">No public projects yet.</p>
    <% } %>
</div>

<script>
async function toggleFollow(username) {
    var btn = document.getElementById('followBtn');
    var following = btn.classList.contains('following');
    try {
        var res = await fetch('/u/' + username + '/follow', { method: 'POST', headers: { 'Content-Type': 'application/json' } });
        var data = await res.json();
        if (data.following) {
            btn.classList.add('following'); btn.textContent = 'Unfollow';
        } else {
            btn.classList.remove('following'); btn.textContent = 'Follow';
        }
    } catch(e) {}
}
</script>

<% } else { %>
<!-- ═══════════════════════════════════════════════════════════════════════════ -->
<!-- OWN PROFILE / SETTINGS VIEW: rendered at /profile                           -->
<!-- ═══════════════════════════════════════════════════════════════════════════ -->
<style>
    .profile-wrap { max-width: 620px; margin: 0 auto; }
    .profile-section {
        border: 1px solid var(--form-border-color);
        border-radius: 8px; padding: 22px 24px;
        background: var(--form-bg-color); margin-bottom: 20px;
    }
    .profile-section h3 { margin: 0 0 16px; font-size: 16px; }
    .field-row { margin-bottom: 12px; }
    .field-row label { display: block; font-size: 12px; opacity: 0.6; margin-bottom: 4px; }
    .field-row input, .field-row textarea, .field-row select { width: 100%; box-sizing: border-box; }
    .field-row textarea { resize: vertical; min-height: 70px; }
    .btn-row { display: flex; gap: 8px; justify-content: flex-end; margin-top: 16px; }
    .btn-primary { padding: 7px 18px; cursor: pointer; border-radius: 5px; border: none; background: var(--button-bg-color); color: inherit; font-size: 13px; }
    .btn-primary:hover { opacity: 0.8; }
    .section-label { font-size: 12px; opacity: 0.45; text-transform: uppercase; letter-spacing: 0.06em; margin: 0 0 14px; }
    .plan-badge { display: inline-block; padding: 2px 10px; border-radius: 20px; font-size: 12px; font-weight: 600; }
    .plan-free { background: var(--form-border-color); opacity: 0.8; }
    .plan-pro { background: #4a90d9; color: #fff; }
    .plan-studio { background: linear-gradient(135deg, #9b59b6, #3498db); color: #fff; }
    .stat-pills { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 8px; }
    .stat-pill { font-size: 13px; padding: 4px 12px; border-radius: 20px; background: var(--form-border-color); opacity: 0.75; }
</style>

<div class="profile-wrap">
    <h2 style="margin-bottom: 20px;">Profile & Settings</h2>

    <% if (typeof successMsg !== 'undefined' && successMsg) { %>
        <div style="background:#27ae6022; border:1px solid #27ae6055; border-radius:8px; padding:10px 14px; margin-bottom:14px; font-size:13px; color:#27ae60;"><%= successMsg %></div>
    <% } %>
    <% if (typeof errorMsg !== 'undefined' && errorMsg) { %>
        <div style="background:#e74c3c22; border:1px solid #e74c3c55; border-radius:8px; padding:10px 14px; margin-bottom:14px; font-size:13px; color:#e74c3c;"><%= errorMsg %></div>
    <% } %>

    <!-- Plan info -->
    <div class="profile-section">
        <div style="display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:8px;">
            <% var plan = (user.plan || 'free'); %>
            <% if (!(typeof monetizationHidden !== 'undefined' && monetizationHidden)) { %>
            <div>
                <h3 style="margin:0 0 4px;">Subscription</h3>
                <span class="plan-badge plan-<%= plan %>"><%= plan === 'studio' ? 'Studio' : plan === 'pro' ? 'Pro' : 'Free' %></span>
            </div>
            <a href="/billing" style="font-size:13px; opacity:0.7; text-decoration:none; padding:6px 14px; border:1px solid var(--form-border-color); border-radius:6px; color:inherit;">
                <%= plan === 'free' ? 'Upgrade Plan' : 'Manage Plan' %> &#8594;
            </a>
            <% } %>
        </div>
        <%
            var storageLimitBytes = plan === 'studio' ? 100*1024*1024*1024 : plan === 'pro' ? 5*1024*1024*1024 : 100*1024*1024;
            var storageUsedBytes = user.storageUsed || 0;
            var storageUsedMB = (storageUsedBytes / 1024 / 1024).toFixed(1);
            var storageLimitMB = (storageLimitBytes / 1024 / 1024 / (storageLimitBytes >= 1024*1024*1024 ? 1024 : 1)).toFixed(0);
            var storageUnit = storageLimitBytes >= 1024*1024*1024 ? 'GB' : 'MB';
            var storageLimitDisplay = storageUnit === 'GB' ? (storageLimitBytes / 1024 / 1024 / 1024).toFixed(0) : storageLimitMB;
            var storagePercent = Math.min(100, Math.round(storageUsedBytes / storageLimitBytes * 100));
        %>
        <div style="margin-top:12px;">
            <div style="display:flex; justify-content:space-between; font-size:12px; opacity:0.6; margin-bottom:4px;">
                <span>Storage used</span>
                <span><%= storageUsedMB %> MB / <%= storageLimitDisplay %> <%= storageUnit %></span>
            </div>
            <div style="background:var(--form-border-color); border-radius:4px; height:6px; overflow:hidden;">
                <div style="background:<%= storagePercent > 90 ? '#e74c3c' : storagePercent > 70 ? '#f39c12' : '#27ae60' %>; width:<%= storagePercent %>%; height:100%; border-radius:4px; transition:width 0.3s;"></div>
            </div>
        </div>
    </div>

    <!-- Public profile stats -->
    <div class="profile-section">
        <h3>Public Profile</h3>
        <div class="stat-pills">
            <span class="stat-pill"><strong><%= (user.followers && user.followers.length) || 0 %></strong> followers</span>
            <span class="stat-pill"><strong><%= (user.following && user.following.length) || 0 %></strong> following</span>
        </div>
        <% if (user.username) { %>
            <p style="font-size:12px; opacity:0.55; margin:10px 0 0;">Public profile: <a href="/u/<%= user.username %>" style="color:inherit; opacity:0.8;">/u/<%= user.username %></a></p>
        <% } else { %>
            <p style="font-size:12px; opacity:0.45; margin:10px 0 0;">Set a username above to get a public profile URL.</p>
        <% } %>
    </div>

    <!-- Account info -->
    <div class="profile-section">
        <h3>Account</h3>
        <form method="POST" action="/profile/update">
            <div class="field-row">
                <label>Display Name</label>
                <input type="text" name="name" value="<%= user.name %>" required>
            </div>
            <div class="field-row">
                <label>Username <span style="opacity:0.5; font-size:11px;">(for your public profile URL)</span></label>
                <input type="text" name="username" value="<%= user.username || '' %>" placeholder="e.g. myname" pattern="[a-z0-9_-]+" title="Lowercase letters, numbers, - and _ only">
            </div>
            <div class="field-row">
                <label>Email</label>
                <input type="email" name="email" value="<%= user.email %>" required>
            </div>
            <div class="field-row">
                <label>Bio <span style="opacity:0.5; font-size:11px;">(shown on your public profile)</span></label>
                <textarea name="bio" placeholder="A short bio about you as a writer…"><%= user.bio || '' %></textarea>
            </div>
            <div class="field-row">
                <label>Avatar URL <span style="opacity:0.5; font-size:11px;">(link to a profile image)</span></label>
                <input type="url" name="avatar" value="<%= user.avatar || '' %>" placeholder="https://…">
            </div>
            <div class="field-row">
                <label>Birthday <span style="opacity:0.5; font-size:11px;">(optional, used for birthday surprises)</span></label>
                <input type="date" name="birthdate" value="<%= user.birthdate ? new Date(user.birthdate).toISOString().split('T')[0] : '' %>">
            </div>
            <div class="btn-row">
                <button class="btn-primary" type="submit">Save Changes</button>
            </div>
        </form>
    </div>

    <!-- Change password -->
    <div class="profile-section">
        <h3>Change Password</h3>
        <form method="POST" action="/profile/password">
            <div class="field-row">
                <label>Current Password</label>
                <input type="password" name="currentPassword" required autocomplete="current-password">
            </div>
            <div class="field-row">
                <label>New Password</label>
                <input type="password" name="newPassword" required autocomplete="new-password">
            </div>
            <div class="field-row">
                <label>Confirm New Password</label>
                <input type="password" name="confirmPassword" required autocomplete="new-password">
            </div>
            <div class="btn-row">
                <button class="btn-primary" type="submit">Update Password</button>
            </div>
        </form>
    </div>

    <!-- Mass export -->
    <div class="profile-section">
        <h3>Export All Projects</h3>
        <p style="font-size:13px; opacity:0.7; margin:0 0 14px;">Download all your projects as a ZIP file. We recommend only editing projects on Catalogue, importing exported files back may overwrite changes.</p>
        <div style="display:flex; gap:10px; align-items:center; flex-wrap:wrap;">
            <select id="exportFormat" style="font-size:13px; padding:6px 10px; border:1px solid var(--form-border-color); border-radius:6px; background:var(--form-bg-color); color:inherit;">
                <option value="md">Markdown (.md)</option>
                <% if (['pro','studio'].includes(user.plan || 'free')) { %>
                    <option value="epub">EPUB (.epub) - Pro+</option>
                <% } %>
            </select>
            <button type="button" class="btn-primary" onclick="startMassExport()">Download ZIP</button>
        </div>
    </div>

    <!-- Danger zone -->
    <div class="profile-section" style="border-color: #e74c3c44;">
        <h3 style="color:#e74c3c;">Danger Zone</h3>
        <p style="font-size:13px; opacity:0.7; margin:0 0 12px;">Permanently deletes your account and all associated projects. This cannot be undone.</p>
        <button class="btn-primary" style="background:#e74c3c;" type="button" onclick="document.getElementById('deleteAccountModal').style.display='flex'">Delete Account</button>
    </div>
</div>

<!-- Delete account confirm modal -->
<div id="deleteAccountModal" style="display:none; position:fixed; inset:0; z-index:200; background:rgba(0,0,0,0.55); align-items:center; justify-content:center;"
     onclick="if(event.target===this)this.style.display='none';">
    <div style="background:var(--background-color); border:1px solid #e74c3c66; border-radius:10px; padding:26px; width:380px; max-width:94vw;">
        <h3 style="margin-top:0; color:#e74c3c;">Delete Account?</h3>
        <p style="font-size:14px; opacity:0.75; margin:0 0 6px;">This will permanently delete:</p>
        <ul style="font-size:13px; opacity:0.7; margin:0 0 18px; padding-left:18px;">
            <li>Your account and login credentials</li>
            <li>All projects you own</li>
            <li>All characters, docs, cards, and tasks within those projects</li>
        </ul>
        <p style="font-size:13px; opacity:0.7; margin:0 0 16px;">Type <strong>DELETE</strong> to confirm:</p>
        <input type="text" id="deleteConfirmInput" placeholder="DELETE" style="width:100%; box-sizing:border-box; margin-bottom:16px;">
        <div style="display:flex; gap:8px; justify-content:flex-end;">
            <button type="button" onclick="document.getElementById('deleteAccountModal').style.display='none'">Cancel</button>
            <form method="POST" action="/profile/delete" style="margin:0;">
                <button type="submit" id="deleteAccountBtn" disabled
                        style="background:#e74c3c; color:#fff; border:none; border-radius:5px; padding:7px 18px; cursor:pointer; opacity:0.4;">
                    Delete My Account
                </button>
            </form>
        </div>
    </div>
</div>

<script>
document.getElementById('deleteConfirmInput').addEventListener('input', function() {
    var btn = document.getElementById('deleteAccountBtn');
    if (this.value === 'DELETE') { btn.disabled = false; btn.style.opacity = '1'; }
    else { btn.disabled = true; btn.style.opacity = '0.4'; }
});

function startMassExport() {
    var format = document.getElementById('exportFormat').value;
    var msg = 'Your projects will be exported as ' + format.toUpperCase() + ' files in a ZIP.\n\nNote: It is recommended to only edit projects on Catalogue; importing exported files back may overwrite changes made since export.\n\nProceed?';
    if (!confirm(msg)) return;
    window.location.href = '/projects/export/all?format=' + format;
}

<% var userPlanProfile = user.plan || 'free'; %>
<% if (!['pro','studio'].includes(userPlanProfile)) { %>
// Gate username to Pro+
var usernameInput = document.querySelector('input[name="username"]');
if (usernameInput) {
    usernameInput.disabled = true;
    usernameInput.title = 'Custom username requires a Pro or Studio plan';
    usernameInput.style.opacity = '0.4';
    <% if (!(typeof monetizationHidden !== 'undefined' && monetizationHidden)) { %>
    var lbl = usernameInput.previousElementSibling;
    if (lbl) lbl.innerHTML += ' <span style="font-size:11px;background:#4a90d9;color:#fff;padding:1px 6px;border-radius:8px;opacity:0.85;">Pro+</span>';
    <% } %>
}
<% } %>
</script>
<% } %>
