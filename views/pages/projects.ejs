<% var name = "Projects"; %>

<style>
    .projects-toolbar { display: flex; gap: 10px; margin-bottom: 20px; flex-wrap: wrap; align-items: center; }
    .projects-toolbar input[type="text"] { flex: 1; min-width: 160px; font-size: 14px; padding: 7px 12px; border-radius: 6px; border: 1px solid var(--form-border-color); background: var(--form-bg-color); color: inherit; }
    .projects-toolbar input[type="text"]:focus { outline: none; border-color: var(--link-color); }
    .projects-wrap { position: relative; }
    #connSvg { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; overflow: visible; z-index: 0; }
    .projects-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 14px; position: relative; z-index: 1; }
    .proj-card { background: var(--form-bg-color); border: 1px solid var(--form-border-color); border-radius: 10px; padding: 16px 18px; display: flex; flex-direction: column; gap: 8px; position: relative; }
    .proj-card.has-connections { border-color: var(--link-color); }
    .proj-card h3 { margin: 0; font-size: 15px; }
    .proj-card .proj-meta { font-size: 12px; opacity: 0.5; display: flex; gap: 8px; flex-wrap: wrap; }
    .proj-card .proj-desc { font-size: 13px; opacity: 0.7; line-height: 1.5; margin: 0; overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; line-clamp: 2; -webkit-box-orient: vertical; }
    .proj-card .proj-actions { display: flex; gap: 6px; margin-top: 4px; flex-wrap: wrap; }
    .shared-badge { display: inline-block; font-size: 11px; padding: 1px 7px; border-radius: 8px; border: 1px solid var(--form-border-color); opacity: 0.6; }
    .no-results-msg { text-align: center; opacity: 0.45; margin-top: 40px; font-size: 14px; }
    .conn-badge { display: inline-flex; align-items: center; gap: 4px; font-size: 11px; opacity: 0.5; margin-top: 2px; }

    /* Modals */
    .modal-overlay { display: none; position: fixed; inset: 0; z-index: 200; background: rgba(0,0,0,0.5); align-items: center; justify-content: center; }
    .modal-overlay.open { display: flex; }
    .modal-box { background: var(--background-color); border: 1px solid var(--form-border-color); border-radius: 10px; padding: 24px; width: 380px; max-width: 94vw; }
    .modal-box h3 { margin: 0 0 14px; font-size: 16px; }
    .modal-field { margin-bottom: 12px; }
    .modal-field label { display: block; font-size: 12px; opacity: 0.6; margin-bottom: 4px; }
    .modal-field select { width: 100%; }
    .modal-actions { display: flex; gap: 8px; justify-content: flex-end; margin-top: 16px; }
</style>

<div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:16px; flex-wrap:wrap; gap:10px;">
    <h2 style="margin:0;">My Projects</h2>
    <div style="display:flex; gap:8px;">
        <button onclick="openAttachModal()" style="font-size:13px; padding:6px 14px;">Attach Projects</button>
        <button onclick="window.location.href='/projects/add'" style="font-size:13px; padding:6px 14px;">+ New Project</button>
    </div>
</div>

<div class="projects-toolbar">
    <input type="text" id="searchInput" placeholder="Search projects…" oninput="filterProjects()">
    <button type="button" onclick="toggleAdvanced()" id="advToggleBtn" style="font-size:13px; padding:7px 14px; white-space:nowrap;">Advanced ▾</button>
</div>
<div id="advancedPanel" style="display:none; background:var(--form-bg-color); border:1px solid var(--form-border-color); border-radius:8px; padding:14px; margin-bottom:16px;">
    <div style="display:grid; grid-template-columns:repeat(auto-fill,minmax(180px,1fr)); gap:10px; align-items:end;">
        <div>
            <label style="font-size:11px; opacity:0.6; display:block; margin-bottom:3px;">Category</label>
            <input type="text" id="advCat" placeholder="e.g. Novel" oninput="filterProjects()" style="width:100%; box-sizing:border-box; font-size:13px;">
        </div>
        <div>
            <label style="font-size:11px; opacity:0.6; display:block; margin-bottom:3px;">Group</label>
            <input type="text" id="advGroup" placeholder="e.g. Summer 2026" oninput="filterProjects()" style="width:100%; box-sizing:border-box; font-size:13px;">
        </div>
        <div>
            <label style="font-size:11px; opacity:0.6; display:block; margin-bottom:3px;">Tags</label>
            <input type="text" id="advTags" placeholder="e.g. fantasy, draft" oninput="filterProjects()" style="width:100%; box-sizing:border-box; font-size:13px;">
        </div>
        <div>
            <label style="font-size:11px; opacity:0.6; display:block; margin-bottom:3px;">Updated After</label>
            <input type="date" id="advAfter" onchange="filterProjects()" style="width:100%; box-sizing:border-box; font-size:13px;">
        </div>
        <div>
            <label style="font-size:11px; opacity:0.6; display:block; margin-bottom:3px;">Updated Before</label>
            <input type="date" id="advBefore" onchange="filterProjects()" style="width:100%; box-sizing:border-box; font-size:13px;">
        </div>
        <div style="display:flex; align-items:flex-end;">
            <button type="button" onclick="clearAdvanced()" style="font-size:12px; padding:5px 10px;">Clear</button>
        </div>
    </div>
</div>

<div class="projects-wrap">
    <svg id="connSvg"></svg>
    <div class="projects-grid" id="projectsGrid">
        <% if (!projects || projects.length === 0) { %>
            <p class="no-results-msg" style="grid-column:1/-1;">No projects yet. <a href="/projects/add">Create your first one.</a></p>
        <% } else { %>
            <% projects.forEach(function(project) { %>
                <%
                    var isOwner = project.owner && project.owner.toString() === user.toString();
                    var hasConns = project.relatedProjects && project.relatedProjects.length > 0;
                %>
                <div class="proj-card <%= hasConns ? 'has-connections' : '' %>"
                     id="pcard-<%= project._id %>"
                     data-id="<%= project._id %>"
                     <% if (project.color) { %>style="border-left: 4px solid <%= project.color %>;"<% } %>
                     data-related='<%= JSON.stringify((project.relatedProjects || []).map(function(r){ return r.toString ? r.toString() : r; })) %>'
                     data-name="<%= (project.name || '').toLowerCase() %>"
                     data-cat="<%= (project.category || '').toLowerCase() %>"
                     data-desc="<%= (project.description || '').toLowerCase() %>"
                     data-group="<%= (project.group || '').toLowerCase() %>"
                     data-tags="<%= ((project.tags || []).join(',')).toLowerCase() %>"
                     data-date="<%= project.lastUpdated ? new Date(project.lastUpdated).toISOString() : '' %>">
                    <div style="display:flex; align-items:flex-start; gap:8px; flex-wrap:wrap;">
                        <h3 style="flex:1;"><%= project.name %></h3>
                        <% if (!isOwner) { %><span class="shared-badge">Shared</span><% } %>
                    </div>
                    <div class="proj-meta">
                        <span><%= project.category || 'Uncategorized' %></span>
                        <span>&middot;</span>
                        <span class="humanized-date" data-date="<%= project.lastUpdated ? new Date(project.lastUpdated).toISOString() : '' %>"></span>
                    </div>
                    <% if (project.description) { %>
                        <p class="proj-desc"><%= project.description %></p>
                    <% } %>
                    <% if (hasConns) { %>
                        <div class="conn-badge">⇆ Linked to <%= project.relatedProjects.length %> project<%= project.relatedProjects.length !== 1 ? 's' : '' %></div>
                    <% } %>
                    <div class="proj-actions">
                        <button onclick="window.location.href='/projects/<%= project._id %>'" style="font-size:13px; padding:5px 12px;">Open</button>
                        <button onclick="window.open('/projects/<%= project._id %>', '_blank')" style="font-size:12px; padding:5px 10px;">New Tab</button>
                        <a href="/projects/<%= project._id %>/export/md" style="font-size:12px; padding:5px 10px; display:inline-flex; align-items:center; border:1px solid var(--form-border-color); border-radius:5px; color:inherit; text-decoration:none; background:var(--background-color);" title="Export as Markdown">↓ MD</a>
                        <% if (isOwner) { %>
                            <button onclick="confirmDelete('<%= project._id %>', decodeURIComponent('<%= encodeURIComponent(project.name) %>'))" style="font-size:12px; padding:5px 10px; color:#e74c3c; border-color:#e74c3c44;">Delete</button>
                        <% } %>
                    </div>
                </div>
            <% }) %>
        <% } %>
    </div>
</div>
<p id="noResultsMsg" class="no-results-msg" style="display:none;">No projects match your search.</p>

<!-- Floating + button -->
<button style="position:fixed; bottom:5%; right:2%; width:52px; height:52px; border-radius:50%; font-size:26px; line-height:1; display:flex; align-items:center; justify-content:center;" onclick="window.location.replace('/projects/add')">+</button>

<!-- Attach modal -->
<div class="modal-overlay" id="attachModal" onclick="if(event.target===this)closeAttachModal()">
    <div class="modal-box">
        <h3>Attach Two Projects</h3>
        <p style="font-size:13px; opacity:0.65; margin:0 0 16px;">Attaching links them together and escalates both to the higher visibility level.</p>
        <div class="modal-field">
            <label>Project A</label>
            <select id="attachA" required>
                <option value="" disabled selected>Select a project…</option>
                <% (projects || []).forEach(function(p) { %>
                    <option value="<%= p._id %>"><%= p.name %></option>
                <% }) %>
            </select>
        </div>
        <div class="modal-field">
            <label>Project B</label>
            <select id="attachB" required>
                <option value="" disabled selected>Select a project…</option>
                <% (projects || []).forEach(function(p) { %>
                    <option value="<%= p._id %>"><%= p.name %></option>
                <% }) %>
            </select>
        </div>
        <div class="modal-actions">
            <button type="button" onclick="closeAttachModal()">Cancel</button>
            <button onclick="submitAttach()">Attach</button>
        </div>
    </div>
</div>

<!-- Delete confirm modal -->
<div class="modal-overlay" id="deleteModal" onclick="if(event.target===this)closeDeleteModal()">
    <div class="modal-box">
        <h3>Delete Project?</h3>
        <p style="font-size:14px; opacity:0.7; margin:0 0 16px;">This permanently deletes <strong id="deleteProjectName"></strong> and cannot be undone.</p>
        <div class="modal-actions">
            <button type="button" onclick="closeDeleteModal()">Cancel</button>
            <button id="deleteConfirmBtn" style="color:#e74c3c; border-color:#e74c3c44;">Delete</button>
        </div>
    </div>
</div>

<script>
// ── Humanize dates ────────────────────────────────────────────────────────────
document.querySelectorAll('.humanized-date[data-date]').forEach(function(el) {
    var d = el.getAttribute('data-date');
    if (d && typeof moment !== 'undefined') el.textContent = moment(d).fromNow();
});

// ── Search filter ─────────────────────────────────────────────────────────────
function toggleAdvanced() {
    var p = document.getElementById('advancedPanel');
    var open = p.style.display !== 'none';
    p.style.display = open ? 'none' : 'block';
    document.getElementById('advToggleBtn').textContent = open ? 'Advanced ▾' : 'Advanced ▲';
}

function clearAdvanced() {
    ['advCat','advGroup','advTags','advAfter','advBefore'].forEach(function(id) {
        document.getElementById(id).value = '';
    });
    filterProjects();
}

function filterProjects() {
    var q     = document.getElementById('searchInput').value.toLowerCase().trim();
    var cat   = document.getElementById('advCat').value.toLowerCase().trim();
    var grp   = document.getElementById('advGroup').value.toLowerCase().trim();
    var tags  = document.getElementById('advTags').value.toLowerCase().trim();
    var after = document.getElementById('advAfter').value;
    var before= document.getElementById('advBefore').value;
    var afterTs  = after  ? new Date(after).getTime()  : 0;
    var beforeTs = before ? new Date(before).getTime() : Infinity;
    var cards = document.querySelectorAll('#projectsGrid .proj-card');
    var visible = 0;
    cards.forEach(function(card) {
        var textMatch = !q ||
            (card.dataset.name  || '').includes(q) ||
            (card.dataset.cat   || '').includes(q) ||
            (card.dataset.desc  || '').includes(q) ||
            (card.dataset.tags  || '').includes(q) ||
            (card.dataset.group || '').includes(q);
        var catMatch  = !cat  || (card.dataset.cat   || '').includes(cat);
        var grpMatch  = !grp  || (card.dataset.group || '').includes(grp);
        var tagsMatch = !tags || tags.split(',').every(function(t) {
            return t.trim() === '' || (card.dataset.tags || '').includes(t.trim());
        });
        var dateStr = card.dataset.date || '';
        var dateTs  = dateStr ? new Date(dateStr).getTime() : 0;
        var dateMatch = (!afterTs || dateTs >= afterTs) && (beforeTs === Infinity || dateTs <= beforeTs);
        var show = textMatch && catMatch && grpMatch && tagsMatch && dateMatch;
        card.style.display = show ? '' : 'none';
        if (show) visible++;
    });
    document.getElementById('noResultsMsg').style.display = visible === 0 && (q || cat || grp || tags || after || before) ? 'block' : 'none';
    drawConnections();
}

// ── SVG connection lines between related projects ─────────────────────────────
function cardCenter(el) {
    var wrap = document.querySelector('.projects-wrap');
    var wrapRect = wrap.getBoundingClientRect();
    var rect = el.getBoundingClientRect();
    return {
        x: rect.left - wrapRect.left + rect.width / 2,
        y: rect.top  - wrapRect.top  + rect.height / 2
    };
}

function drawConnections() {
    var svg = document.getElementById('connSvg');
    svg.innerHTML = '';
    var drawn = new Set();
    document.querySelectorAll('.proj-card[data-related]').forEach(function(card) {
        if (card.style.display === 'none') return;
        var id = card.dataset.id;
        var related;
        try { related = JSON.parse(card.dataset.related); } catch(e) { return; }
        related.forEach(function(rid) {
            var key = [id, rid].sort().join('|');
            if (drawn.has(key)) return;
            var targetCard = document.getElementById('pcard-' + rid);
            if (!targetCard || targetCard.style.display === 'none') return;
            drawn.add(key);
            var a = cardCenter(card), b = cardCenter(targetCard);
            var line = document.createElementNS('http://www.w3.org/2000/svg', 'line');
            line.setAttribute('x1', a.x); line.setAttribute('y1', a.y);
            line.setAttribute('x2', b.x); line.setAttribute('y2', b.y);
            line.setAttribute('stroke', 'var(--link-color)');
            line.setAttribute('stroke-width', '1.5');
            line.setAttribute('stroke-dasharray', '5 4');
            line.setAttribute('opacity', '0.45');
            svg.appendChild(line);
        });
    });
}

requestAnimationFrame(drawConnections);
window.addEventListener('resize', drawConnections);

// ── Attach modal ──────────────────────────────────────────────────────────────
function openAttachModal() { document.getElementById('attachModal').classList.add('open'); }
function closeAttachModal() { document.getElementById('attachModal').classList.remove('open'); }

function submitAttach() {
    var a = document.getElementById('attachA').value;
    var b = document.getElementById('attachB').value;
    if (!a || !b) return;
    if (a === b) { alert('Please select two different projects.'); return; }
    fetch('/projects/' + a + '/projects/add', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify({ relatedProjectId: b })
    }).then(function() { closeAttachModal(); window.location.reload(); });
}

// ── Delete ────────────────────────────────────────────────────────────────────
var pendingDeleteId = null;
function confirmDelete(id, name) {
    pendingDeleteId = id;
    document.getElementById('deleteProjectName').textContent = name;
    document.getElementById('deleteModal').classList.add('open');
}
function closeDeleteModal() {
    pendingDeleteId = null;
    document.getElementById('deleteModal').classList.remove('open');
}
document.getElementById('deleteConfirmBtn').addEventListener('click', function() {
    if (!pendingDeleteId) return;
    fetch('/projects/' + pendingDeleteId + '/delete', {
        method: 'POST',
        headers: { 'Accept': 'application/json' }
    }).then(function() { window.location.reload(); });
});
</script>
