// ── Research connection panel ──────────────────────────────────────────────────
var _resConnSel = null;
function openResConnPanel(e, docId, srcId, tgtId) {
    e.stopPropagation();
    _resConnSel = { docId: docId, srcId: srcId, tgtId: tgtId };
    var srcCard = document.getElementById('rsec-' + srcId);
    var conns = srcCard ? parseResConns(srcCard.dataset.conns) : [];
    var conn = conns.find(function(c) { return c.targetId === tgtId; }) || {};
    document.getElementById('rcpColor').value  = conn.color     || '#4a90d9';
    document.getElementById('rcpWidth').value  = conn.width     || 1.5;
    document.getElementById('rcpStyle').value  = conn.lineStyle || 'solid';
    document.getElementById('rcpSymbol').value = conn.symbol    || 'none';
    document.getElementById('rcpLabel').value  = conn.label     || '';
    var panel = document.getElementById('resConnPanel');
    panel.style.display = 'block';
    panel.style.left = Math.min(e.clientX+8, window.innerWidth-220) + 'px';
    panel.style.top  = Math.min(e.clientY+8, window.innerHeight-290) + 'px';
}
function closeResConnPanel() { document.getElementById('resConnPanel').style.display='none'; _resConnSel=null; }
function resConnLivePreview() {
    if (!_resConnSel) return;
    drawResearchLines(_resConnSel.docId, { srcId:_resConnSel.srcId, tgtId:_resConnSel.tgtId, color:document.getElementById('rcpColor').value, width:document.getElementById('rcpWidth').value, lineStyle:document.getElementById('rcpStyle').value, symbol:document.getElementById('rcpSymbol').value, label:document.getElementById('rcpLabel').value });
}
function saveResConnProps() {
    if (!_resConnSel) return;
    var docId=_resConnSel.docId, srcId=_resConnSel.srcId, tgtId=_resConnSel.tgtId;
    var color=document.getElementById('rcpColor').value, width=parseFloat(document.getElementById('rcpWidth').value), lineStyle=document.getElementById('rcpStyle').value, symbol=document.getElementById('rcpSymbol').value, label=document.getElementById('rcpLabel').value;
    var srcCard=document.getElementById('rsec-'+srcId);
    if (srcCard) { var conns=parseResConns(srcCard.dataset.conns); var conn=conns.find(function(c){return c.targetId===tgtId;}); if(conn){conn.color=color;conn.width=width;conn.lineStyle=lineStyle;conn.symbol=symbol;conn.label=label;} srcCard.dataset.conns=JSON.stringify(conns); }
    fetch('/projects/'+projectId+'/docs/'+docId+'/sections/'+srcId+'/connection/'+tgtId, { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({color,width,lineStyle,symbol,label}) });
    drawResearchLines(docId); closeResConnPanel();
}
function disconnectResConn() {
    if (!_resConnSel) return;
    var docId=_resConnSel.docId, srcId=_resConnSel.srcId, tgtId=_resConnSel.tgtId;
    fetch('/projects/'+projectId+'/docs/'+docId+'/sections/'+srcId+'/disconnect', { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({targetSectionId:tgtId}) }).then(function(){
        var srcCard=document.getElementById('rsec-'+srcId);
        if(srcCard){ srcCard.dataset.conns=JSON.stringify(parseResConns(srcCard.dataset.conns).filter(function(c){return c.targetId!==tgtId;})); }
        drawResearchLines(docId); closeResConnPanel();
    });
}
document.addEventListener('click', function(e) { var p=document.getElementById('resConnPanel'); if(p&&p.style.display!=='none'&&!p.contains(e.target)) closeResConnPanel(); });

// ── Auto-organize ──────────────────────────────────────────────────────────────
function autoOrganize(docId) {
    var canvas=document.getElementById('resCanvas-'+docId); if(!canvas) return;
    var groups={};
    canvas.querySelectorAll('.research-card').forEach(function(c){ var g=decodeURIComponent(c.dataset.group||'')||'(ungrouped)'; if(!groups[g]) groups[g]=[]; groups[g].push(c); });
    var colX=20; var colGap=250, rowGap=200, rowStart=20;
    Object.keys(groups).forEach(function(g){ groups[g].forEach(function(c,i){ c.style.left=colX+'px'; c.style.top=(rowStart+i*rowGap)+'px'; }); colX+=colGap; });
    drawResearchLines(docId);
}

// ── Edit research card ─────────────────────────────────────────────────────────
var _editResId=null, _editResDocId=null;
window.openEditResCard = function(secId, docId) {
    _editResId=secId; _editResDocId=docId;
    var card=document.getElementById('rsec-'+secId);
    document.getElementById('ercTitle').value   = decodeURIComponent(card.dataset.title   || '');
    document.getElementById('ercDesc').value    = decodeURIComponent(card.dataset.desc    || '');
    document.getElementById('ercGroup').value   = decodeURIComponent(card.dataset.group   || '');
    document.getElementById('ercContent').value = decodeURIComponent(card.dataset.content || '');
    document.getElementById('ercRefLink').value = decodeURIComponent(card.dataset.reflink || '');
    document.getElementById('ercMediaForm').action = '/projects/'+projectId+'/docs/'+docId+'/sections/'+secId+'/media';
    document.getElementById('editResCardModal').classList.add('open');
};
window.saveResCard = function() {
    if (!_editResId) return;
    var body={title:document.getElementById('ercTitle').value, description:document.getElementById('ercDesc').value, group:document.getElementById('ercGroup').value, content:document.getElementById('ercContent').value, refLink:document.getElementById('ercRefLink').value};
    fetch('/projects/'+projectId+'/docs/'+_editResDocId+'/sections/'+_editResId+'/meta', { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify(body) }).then(function(r){
        if(!r.ok) return;
        var card=document.getElementById('rsec-'+_editResId); if(!card) return;
        card.dataset.title=encodeURIComponent(body.title); card.dataset.desc=encodeURIComponent(body.description); card.dataset.group=encodeURIComponent(body.group); card.dataset.content=encodeURIComponent(body.content); card.dataset.reflink=encodeURIComponent(body.refLink);
        card.querySelector('.rc-title').textContent=body.title;
        var descEl=card.querySelector('.rc-desc'); if(body.description){if(descEl)descEl.textContent=body.description; else{var d=document.createElement('p');d.className='rc-desc';d.textContent=body.description;card.querySelector('.rc-title').after(d);}} else if(descEl) descEl.remove();
        var cEl=card.querySelector('.rc-content'); if(body.content){if(cEl)cEl.textContent=body.content.substring(0,120); else{var c2=document.createElement('p');c2.className='rc-content';c2.textContent=body.content.substring(0,120);card.querySelector('.rc-actions').before(c2);}} else if(cEl) cEl.remove();
        var rEl=card.querySelector('.rc-reflink'); if(body.refLink){if(rEl)rEl.textContent=body.refLink; else{var r2=document.createElement('p');r2.className='rc-reflink';r2.textContent=body.refLink;card.querySelector('.rc-actions').before(r2);}} else if(rEl) rEl.remove();
        var gEl=card.querySelector('.rc-group'); if(body.group){if(gEl)gEl.textContent=body.group; else{var g2=document.createElement('span');g2.className='rc-group';g2.textContent=body.group;card.insertBefore(g2,card.firstChild);}} else if(gEl) gEl.remove();
        closeModal('editResCardModal');
    });
};

// ── Import ─────────────────────────────────────────────────────────────────────
async function importDoc() {
    var file=document.getElementById('importFile').files[0];
    var status=document.getElementById('importStatus');
    if(!file){status.textContent='Please select a file.'; return;}
    var ext=file.name.split('.').pop().toLowerCase();
    var endpoint=(ext==='docx')?'/projects/'+projectId+'/docs/import/docx':'/projects/'+projectId+'/docs/import/md';
    var form=new FormData(); form.append('file',file);
    status.textContent='Importing…';
    try {
        var res=await fetch(endpoint,{method:'POST',body:form});
        var data=await res.json();
        if(res.ok&&data.ok){ status.textContent='Imported! Reloading…'; if(typeof showToast==='function') showToast('Import complete!','success'); setTimeout(function(){window.location.reload();},800); }
        else { status.textContent='Error: '+(data.error||'Unknown error'); }
    } catch(e) { status.textContent='Network error.'; }
}

