    var docEl = document.getElementById('docview-' + docId);
    if (!docEl) { list.innerHTML = '<p style="font-size:12px;opacity:0.4;padding:12px;">No doc open</p>'; return; }
    if (docEl.querySelector('.research-canvas')) {
        list.innerHTML = '<p style="font-size:12px;opacity:0.4;padding:12px;">Research canvas</p>'; return;
    }
    var blocks = docEl.querySelectorAll('.sec-block');
