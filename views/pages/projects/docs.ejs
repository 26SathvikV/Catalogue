}

// ── File upload ───────────────────────────────────────────────────────────────
function handleFileUpload(files, parentId) {
    if (!files || !files.length) return;
    Array.from(files).forEach(function(file) {
        var fd = new FormData();
        fd.append('file', file);
        fd.append('title', file.name);
        if (parentId) fd.append('parentId', parentId);
        fetch('/projects/' + projectId + '/docs/upload-file', { method: 'POST', body: fd })
            .then(function(r) { return r.json(); })
            .then(function(d) {
                if (!d.ok) { alert(d.error || 'Upload failed'); return; }
                _allDocs.push({ _id: d.doc._id, title: d.doc.title, docType: 'file', parentId: d.doc.parentId || null, icon: d.doc.icon, isResearch: false, fileUrl: d.doc.fileUrl, fileName: d.doc.fileName, mimeType: d.doc.mimeType });
                if (d.doc.parentId) _expandedFolders[d.doc.parentId] = true;
                renderDocTree();
                // Reload to see file viewer
                window.location.reload();
            }).catch(function() { alert('Upload failed'); });
    });
}

function uploadNewVersion(docId, file) {
    if (!file) return;
    var fd = new FormData();
    fd.append('file', file);
    fetch('/projects/' + projectId + '/docs/' + docId + '/upload-version', { method: 'POST', body: fd })
        .then(function(r) { return r.json(); })
        .then(function(d) {
            if (d.ok) window.location.reload();
            else alert(d.error || 'Upload failed');
        });
}

function convertToDoc(docId) {
    if (!confirm('Convert this file to a Catalogue document? The file will remain available for download.')) return;
    fetch('/projects/' + projectId + '/docs/' + docId + '/convert', { method: 'POST', headers: { 'Accept': 'application/json' } })
        .then(function(r) { return r.json(); })
        .then(function(d) {
            if (d.ok) window.location.reload();
            else alert(d.error || 'Conversion failed');
        });
}

