<script>
var projectId = '<%= projectId %>';
var _addSecDocId = null, _addResDocId = null;
var _currentDocId = null;
var _iconPickerDocId = null, _iconPickerSelected = null;

// ── Docs data (for tree) ───────────────────────────────────────────────────────
var _allDocs = <%- JSON.stringify(docs.map(function(d) {
    return {
        _id: d._id.toString(),
        title: d.title || 'Untitled',
        docType: d.docType || 'doc',
        parentId: d.parentId ? d.parentId.toString() : null,
        icon: d.icon || null,
        isResearch: !!d.isResearch,
        fileUrl: d.fileUrl || null,
        fileName: d.fileName || null,
        mimeType: d.mimeType || null
    };
})) %>;

// ── File type icon (client-side mirror) ───────────────────────────────────────
function clientFileTypeIcon(mime, name) {
    if (mime) {
        if (mime.startsWith('image/')) return 'image-outline';
        if (mime.startsWith('video/')) return 'film-outline';
        if (mime.startsWith('audio/')) return 'musical-notes-outline';
        if (mime === 'application/pdf') return 'document-outline';
        if (mime.includes('word') || mime.includes('wordprocessingml')) return 'document-text-outline';
        if (mime.includes('spreadsheet') || mime.includes('excel') || mime === 'text/csv') return 'grid-outline';
        if (mime.includes('presentation') || mime.includes('powerpoint')) return 'easel-outline';
        if (mime.includes('zip') || mime.includes('archive') || mime.includes('compressed')) return 'archive-outline';
        if (mime.startsWith('text/')) return 'document-text-outline';
    }
    if (name) {
        var ext = name.split('.').pop().toLowerCase();
        var m = {jpg:'image-outline',jpeg:'image-outline',png:'image-outline',gif:'image-outline',svg:'image-outline',webp:'image-outline',mp4:'film-outline',mov:'film-outline',avi:'film-outline',webm:'film-outline',mp3:'musical-notes-outline',wav:'musical-notes-outline',ogg:'musical-notes-outline',flac:'musical-notes-outline',pdf:'document-outline',docx:'document-text-outline',doc:'document-text-outline',md:'code-slash-outline',markdown:'code-slash-outline',txt:'document-text-outline',zip:'archive-outline',rar:'archive-outline',tar:'archive-outline',gz:'archive-outline',psd:'easel-outline',ai:'easel-outline',xlsx:'grid-outline',xls:'grid-outline',csv:'grid-outline',pptx:'easel-outline',ppt:'easel-outline'};
        return m[ext] || 'attach-outline';
    }
    return 'attach-outline';
}

function getDocIcon(d) {
    if (d.icon) return d.icon;
    if (d.docType === 'folder') return 'folder-outline';
    if (d.docType === 'file') return clientFileTypeIcon(d.mimeType, d.fileName);
    if (d.isResearch) return 'flask-outline';
    return 'document-text-outline';
}

// ── Doc tree ──────────────────────────────────────────────────────────────────
var _expandedFolders = {};

function buildDocTree(docs) {
    var map = {};
    docs.forEach(function(d) { map[d._id] = Object.assign({}, d, { children: [] }); });
    var roots = [];
    docs.forEach(function(d) {
        if (d.parentId && map[d.parentId]) map[d.parentId].children.push(map[d._id]);
        else roots.push(map[d._id]);
    });
    return roots;
}

function renderDocTree() {
    var root = document.getElementById('docTreeRoot');
    if (!root) return;
    root.innerHTML = '';
    renderNodes(buildDocTree(_allDocs), root, 0);
}

function renderNodes(nodes, container, depth) {
    nodes.forEach(function(d) {
        var item = document.createElement('div');
        item.className = 'doc-nav-item' + (_currentDocId === d._id ? ' active' : '');
        item.id = 'nav-' + d._id;
        item.style.paddingLeft = (14 + depth * 14) + 'px';

        if (d.docType === 'folder') {
            var arrow = document.createElement('span');
            arrow.className = 'folder-arrow';
            arrow.textContent = _expandedFolders[d._id] ? '▼' : '▶';
            item.appendChild(arrow);
        }

        var ico = document.createElement('ion-icon');
        ico.setAttribute('name', getDocIcon(d));
        ico.className = 'doc-nav-icon';
        ico.title = 'Click to change icon';
        ico.addEventListener('click', function(e) { e.stopPropagation(); openIconPicker(d._id); });
        item.appendChild(ico);

        var nameSpan = document.createElement('span');
        nameSpan.className = 'doc-nav-name';
        nameSpan.id = 'navname-' + d._id;
        nameSpan.textContent = d.title;
        nameSpan.title = 'Double-click to rename';
        nameSpan.addEventListener('dblclick', function(e) { startRename(e, d._id); });
        item.appendChild(nameSpan);

        if (d.isResearch && d.docType === 'doc') {
            var tag = document.createElement('span');
            tag.className = 'research-tag';
            tag.textContent = 'R';
            item.appendChild(tag);
        }

        if (d.docType === 'folder') {
            item.addEventListener('click', function() { toggleFolder(d._id); });
        } else {
            item.addEventListener('click', function() { switchDoc(d._id); });
        }

        container.appendChild(item);

        if (d.docType === 'folder') {
            var childWrap = document.createElement('div');
            childWrap.id = 'folder-children-' + d._id;
            childWrap.style.display = _expandedFolders[d._id] ? '' : 'none';
            container.appendChild(childWrap);
            if (d.children.length > 0) renderNodes(d.children, childWrap, depth + 1);
        }
    });
}

function toggleFolder(folderId) {
    _expandedFolders[folderId] = !_expandedFolders[folderId];
    renderDocTree();
}

// ── New Doc / Folder ──────────────────────────────────────────────────────────
function showNewDocModal() {
    document.getElementById('newDocModalTitle').textContent = 'New Document';
    document.getElementById('newDocTitle').value = '';
    document.getElementById('newDocIsResearch').checked = false;
    document.getElementById('newDocResearchRow').style.display = '';
    // Populate folder selector
    var sel = document.getElementById('newDocParentSel');
    sel.innerHTML = '<option value="">-- Top level --</option>';
    _allDocs.filter(function(d) { return d.docType === 'folder'; }).forEach(function(d) {
        var opt = document.createElement('option'); opt.value = d._id; opt.textContent = d.title; sel.appendChild(opt);
    });
    document.getElementById('newDocModal').classList.add('open');
    setTimeout(function() { document.getElementById('newDocTitle').focus(); }, 50);
}

function createFolder() {
    var name = prompt('Folder name:');
    if (!name) return;
    fetch('/projects/' + projectId + '/docs', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify({ title: name, docType: 'folder' })
    }).then(function(r) { return r.json(); }).then(function(d) {
        if (!d.ok) return;
        _allDocs.push({ _id: d.doc._id, title: d.doc.title, docType: 'folder', parentId: d.doc.parentId || null, icon: null, isResearch: false, fileUrl: null, fileName: null, mimeType: null });
        _expandedFolders[d.doc._id] = true;
        renderDocTree();
    });
}

function submitNewDoc() {
    var title = document.getElementById('newDocTitle').value.trim();
    var isResearch = document.getElementById('newDocIsResearch').checked;
    var parentId = document.getElementById('newDocParentSel').value;
    if (!title) { document.getElementById('newDocTitle').focus(); return; }
    fetch('/projects/' + projectId + '/docs', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify({ title: title, isResearch: isResearch, parentId: parentId || undefined })
    }).then(function(r) { return r.json(); }).then(function(d) {
        if (!d.ok) return;
        closeModal('newDocModal');
        _allDocs.push({ _id: d.doc._id, title: d.doc.title, docType: 'doc', parentId: d.doc.parentId || null, icon: null, isResearch: isResearch, fileUrl: null, fileName: null, mimeType: null });
        if (d.doc.parentId) _expandedFolders[d.doc.parentId] = true;
        renderDocTree();
        // Reload page to get the new doc's editor
        window.location.reload();
