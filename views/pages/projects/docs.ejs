// ── Section drag-to-reorder ────────────────────────────────────────────────────
var _dragSec = null;

function initSectionDragItem(item, docId) {
    var handle = item.querySelector('.drag-handle');
    if (!handle || handle._initialized) return;
    handle._initialized = true;
    handle.addEventListener('mousedown', function(e) {
        e.preventDefault();
        _dragSec = { item: item, docId: docId, startY: e.clientY };
        item.classList.add('dragging-sec');
    });
}

document.addEventListener('mousemove', function(e) {
    if (!_dragSec) return;
    var container = document.getElementById('bysec-' + _dragSec.docId);
    if (!container) return;
    var items = Array.from(container.querySelectorAll('.sec-block:not(.dragging-sec)'));
    items.forEach(function(it) { it.classList.remove('drag-over-sec'); });
    var closest = null, minDist = Infinity;
    items.forEach(function(it) {
        var rect = it.getBoundingClientRect();
        var dist = Math.abs(e.clientY - rect.top);
        if (dist < minDist) { minDist = dist; closest = it; }
    });
    if (closest) closest.classList.add('drag-over-sec');
});

document.addEventListener('mouseup', function() {
    if (!_dragSec) return;
    var item = _dragSec.item, docId = _dragSec.docId;
    _dragSec = null;
    item.classList.remove('dragging-sec');
    var container = document.getElementById('bysec-' + docId);
    if (!container) return;
    var overItem = container.querySelector('.sec-block.drag-over-sec');
    container.querySelectorAll('.sec-block').forEach(function(it) { it.classList.remove('drag-over-sec'); });
    if (overItem && overItem !== item) container.insertBefore(item, overItem);
    var orderedIds = Array.from(container.querySelectorAll('.sec-block')).map(function(it) { return it.dataset.secid; }).filter(Boolean);
    if (orderedIds.length) {
        fetch('/projects/' + projectId + '/docs/' + docId + '/sections/reorder', {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ orderedIds: orderedIds })
        });
        updateSectionsNav(docId);
    }
});

// Init drag on existing blocks
document.querySelectorAll('.sec-block').forEach(function(block) {
    var docId = block.closest('.doc-view').id.replace('docview-','');
    initSectionDragItem(block, docId);
});

// ── Research canvas drag ───────────────────────────────────────────────────────
var dragResConn = null;

function initResCardDrag(card) {
    if (card._dragInit) return;
    card._dragInit = true;
    card.addEventListener('mousedown', function(e) {
        if (e.target.tagName === 'BUTTON' || e.target.tagName === 'IMG') return;
        _rDragging = card; _rOffX = e.offsetX; _rOffY = e.offsetY;
        card.style.zIndex = 10; e.preventDefault();
    });
}

var _rDragging = null, _rOffX = 0, _rOffY = 0;
document.querySelectorAll('.research-card').forEach(initResCardDrag);

window.startResConnDrag = function(e, secId, docId) {
    e.stopPropagation(); e.preventDefault();
    dragResConn = { sourceId: secId, docId: docId };
    var canvas = document.getElementById('resCanvas-' + docId);
    var center = resCenter(canvas, secId);
    if (center) {
        var dl = document.getElementById('resDragLine-' + docId);
        if (dl) { dl.setAttribute('x1', center.x); dl.setAttribute('y1', center.y); dl.setAttribute('x2', center.x); dl.setAttribute('y2', center.y); dl.setAttribute('visibility', 'visible'); }
    }
    e.target.closest('.rc-connect-btn').classList.add('primed');
};

document.addEventListener('mousemove', function(e) {
    if (_rDragging) {
        var canvas = _rDragging.closest('.research-canvas');
        var rect = canvas.getBoundingClientRect();
        _rDragging.style.left = (e.clientX - rect.left - _rOffX) + 'px';
        _rDragging.style.top  = (e.clientY - rect.top  - _rOffY) + 'px';
        drawResearchLines(_rDragging.dataset.docid);
    }
    if (dragResConn) {
        var canvas = document.getElementById('resCanvas-' + dragResConn.docId);
        if (!canvas) return;
        var rect = canvas.getBoundingClientRect();
        var mx = e.clientX - rect.left, my = e.clientY - rect.top;
        var src = canvas.querySelector('[data-id="' + dragResConn.sourceId + '"]');
        if (src) {
            var fcx = parseInt(src.style.left) + src.offsetWidth / 2;
            var fcy = parseInt(src.style.top)  + src.offsetHeight / 2;
            var dx = mx - fcx, dy = my - fcy;
            var hw = src.offsetWidth / 2, hh = src.offsetHeight / 2;
            var scale = (Math.abs(dx) < 0.01 && Math.abs(dy) < 0.01) ? 0 : Math.min(hw / Math.max(Math.abs(dx),0.001), hh / Math.max(Math.abs(dy),0.001));
            var dl = document.getElementById('resDragLine-' + dragResConn.docId);
            if (dl) { dl.setAttribute('x1', fcx+dx*scale); dl.setAttribute('y1', fcy+dy*scale); dl.setAttribute('x2', mx); dl.setAttribute('y2', my); dl.setAttribute('visibility','visible'); }
        }
    }
});
document.addEventListener('mouseup', function(e) {
    if (_rDragging) {
        _rDragging.style.zIndex = 2;
        var id = _rDragging.dataset.id, docId = _rDragging.dataset.docid;
        var x = parseInt(_rDragging.style.left) || 0, y = parseInt(_rDragging.style.top) || 0;
        _rDragging = null;
        fetch('/projects/' + projectId + '/docs/' + docId + '/sections/' + id + '/position', {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ position: x, positionY: y })
        });
    }
    if (dragResConn) {
        var docId = dragResConn.docId, srcId = dragResConn.sourceId;
        dragResConn = null;
        var dl = document.getElementById('resDragLine-' + docId);
        if (dl) dl.setAttribute('visibility','hidden');
        document.querySelectorAll('#resCanvas-' + docId + ' .rc-connect-btn').forEach(function(b) { b.classList.remove('primed'); });
        var target = e.target.closest('.research-card');
        if (target && target.dataset.id !== srcId && target.dataset.docid === docId) {
            var tid = target.dataset.id;
            fetch('/projects/' + projectId + '/docs/' + docId + '/sections/' + srcId + '/connect', {
                method: 'POST', headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ targetSectionId: tid })
            }).then(function() {
                var srcCard = document.getElementById('rsec-' + srcId);
                if (srcCard) {
                    var conns = parseResConns(srcCard.dataset.conns);
                    if (!conns.find(function(c) { return c.targetId === tid; })) {
                        conns.push({ targetId: tid, color: '#4a90d9', width: 1.5, lineStyle: 'solid', symbol: 'none', label: '' });
                        srcCard.dataset.conns = JSON.stringify(conns);
                    }
                }
                drawResearchLines(docId);
            });
        } else { drawResearchLines(docId); }
    }
});

// ── Research SVG lines ─────────────────────────────────────────────────────────
function parseResConns(raw) { if (!raw) return []; try { return JSON.parse(raw); } catch(e) { return []; } }

function resCenter(canvas, id) {
    var el = canvas.querySelector('[data-id="' + id + '"]');
    if (!el) return null;
    return { x: parseInt(el.style.left) + el.offsetWidth / 2, y: parseInt(el.style.top) + el.offsetHeight / 2 };
}

function resEdgePoint(canvas, fromId, toId) {
    var from = canvas.querySelector('[data-id="' + fromId + '"]');
    var to   = canvas.querySelector('[data-id="' + toId   + '"]');
    if (!from || !to) return null;
    var fx = parseInt(from.style.left) + from.offsetWidth / 2, fy = parseInt(from.style.top) + from.offsetHeight / 2;
    var tx = parseInt(to.style.left)   + to.offsetWidth   / 2, ty = parseInt(to.style.top)   + to.offsetHeight  / 2;
    var dx = tx - fx, dy = ty - fy;
    if (dx === 0 && dy === 0) return { x: fx, y: fy };
    var hw = from.offsetWidth / 2, hh = from.offsetHeight / 2;
    var scale = Math.min(hw / Math.max(Math.abs(dx),0.001), hh / Math.max(Math.abs(dy),0.001));
    return { x: fx + dx * scale, y: fy + dy * scale };
}

function drawMidSymbol(mx, my, shape, color, size) {
    if (!shape || shape === 'none') return null;
    size = size || 7;
    var NS = 'http://www.w3.org/2000/svg';
    var el, g;
    switch(shape) {
        case 'circle': el = document.createElementNS(NS,'circle'); el.setAttribute('cx',mx); el.setAttribute('cy',my); el.setAttribute('r',size); el.setAttribute('fill',color); break;
        case 'square': el = document.createElementNS(NS,'rect'); el.setAttribute('x',mx-size); el.setAttribute('y',my-size); el.setAttribute('width',size*2); el.setAttribute('height',size*2); el.setAttribute('fill',color); break;
        case 'diamond': el = document.createElementNS(NS,'polygon'); el.setAttribute('points',mx+','+(my-size*1.3)+' '+(mx+size)+','+my+' '+mx+','+(my+size*1.3)+' '+(mx-size)+','+my); el.setAttribute('fill',color); break;
        case 'triangle': el = document.createElementNS(NS,'polygon'); el.setAttribute('points',mx+','+(my-size*1.3)+' '+(mx+size*1.1)+','+(my+size)+' '+(mx-size*1.1)+','+(my+size)); el.setAttribute('fill',color); break;
        case 'hexagon': { var hpts=[]; for(var hi=0;hi<6;hi++){var ha=Math.PI/180*(60*hi-30); hpts.push((mx+size*Math.cos(ha))+','+(my+size*Math.sin(ha)));} el=document.createElementNS(NS,'polygon'); el.setAttribute('points',hpts.join(' ')); el.setAttribute('fill',color); break; }
        case 'star': { var spts=[]; for(var si=0;si<10;si++){var sr=si%2===0?size:size*0.45; var sa=Math.PI/180*(36*si-90); spts.push((mx+sr*Math.cos(sa))+','+(my+sr*Math.sin(sa)));} el=document.createElementNS(NS,'polygon'); el.setAttribute('points',spts.join(' ')); el.setAttribute('fill',color); break; }
        case 'plus': { var pt=size*0.35; el=document.createElementNS(NS,'polygon'); el.setAttribute('points',(mx-pt)+','+(my-size)+' '+(mx+pt)+','+(my-size)+' '+(mx+pt)+','+(my-pt)+' '+(mx+size)+','+(my-pt)+' '+(mx+size)+','+(my+pt)+' '+(mx+pt)+','+(my+pt)+' '+(mx+pt)+','+(my+size)+' '+(mx-pt)+','+(my+size)+' '+(mx-pt)+','+(my+pt)+' '+(mx-size)+','+(my+pt)+' '+(mx-size)+','+(my-pt)+' '+(mx-pt)+','+(my-pt)); el.setAttribute('fill',color); break; }
        case 'x': { g=document.createElementNS(NS,'g'); var xt=size*0.3; var xp=document.createElementNS(NS,'polygon'); xp.setAttribute('points',(mx-size)+','+(my-xt)+' '+(mx-xt)+','+my+' '+(mx-size)+','+(my+xt)+' '+(mx-xt)+','+(my+size)+' '+mx+','+(my+xt)+' '+(mx+xt)+','+(my+size)+' '+(mx+size)+','+(my+xt)+' '+(mx+xt)+','+my+' '+(mx+size)+','+(my-xt)+' '+(mx+xt)+','+(my-size)+' '+mx+','+(my-xt)+' '+(mx-xt)+','+(my-size)); xp.setAttribute('fill',color); g.appendChild(xp); break; }
        case 'arrow': { g=document.createElementNS(NS,'g'); var at=document.createElementNS(NS,'polygon'); at.setAttribute('points',mx+','+(my-size*1.1)+' '+(mx+size)+','+(my+size*0.6)+' '+(mx-size)+','+(my+size*0.6)); at.setAttribute('fill',color); g.appendChild(at); break; }
    }
    return g || el || null;
}

function drawResearchLines(docId, preview) {
    var svg = document.getElementById('researchSvg-' + docId);
    if (!svg) return;
    var dragLine = document.getElementById('resDragLine-' + docId);
    svg.innerHTML = '';
    var canvas = svg.parentElement;
    var drawn = new Set();
    var NS = 'http://www.w3.org/2000/svg';
    canvas.querySelectorAll('.research-card').forEach(function(card) {
        var id = card.dataset.id;
        parseResConns(card.dataset.conns).forEach(function(conn) {
            var tid = conn.targetId;
            var key = [id,tid].sort().join('-');
            if (drawn.has(key)) return; drawn.add(key);
            var a = resEdgePoint(canvas, id, tid), b = resEdgePoint(canvas, tid, id);
            if (!a || !b) return;
            var color = conn.color||'#4a90d9', width = conn.width||1.5, lstyle = conn.lineStyle||'solid', sym = conn.symbol||'none', label = conn.label||'';
            if (preview && ((preview.srcId===id&&preview.tgtId===tid)||(preview.srcId===tid&&preview.tgtId===id))) {
                color=preview.color||color; width=parseFloat(preview.width)||width; lstyle=preview.lineStyle||lstyle;
                sym=preview.symbol!==undefined?preview.symbol:sym; label=preview.label!==undefined?preview.label:label;
            }
            var dash = lstyle==='dashed'?'8,5':(lstyle==='dotted'?'2,4':null);
            var mx2=(a.x+b.x)/2, my2=(a.y+b.y)/2;
            var line=document.createElementNS(NS,'line');
            line.setAttribute('x1',a.x); line.setAttribute('y1',a.y); line.setAttribute('x2',b.x); line.setAttribute('y2',b.y);
            line.setAttribute('stroke',color); line.setAttribute('stroke-width',width);
            if (dash) line.setAttribute('stroke-dasharray',dash);
            svg.appendChild(line);
            if (sym&&sym!=='none') { var symEl=drawMidSymbol(mx2,my2,sym,color,7); if(symEl) svg.appendChild(symEl); }
            if (label) {
                var lblY = my2+(sym&&sym!=='none'?18:-6);
                var txt=document.createElementNS(NS,'text'); txt.setAttribute('x',mx2); txt.setAttribute('y',lblY); txt.setAttribute('text-anchor','middle'); txt.setAttribute('font-size','11'); txt.setAttribute('fill',color); txt.textContent=label; svg.appendChild(txt);
                try { var bb=txt.getBBox(); var bg=document.createElementNS(NS,'rect'); bg.setAttribute('x',bb.x-2); bg.setAttribute('y',bb.y-2); bg.setAttribute('width',bb.width+4); bg.setAttribute('height',bb.height+4); bg.setAttribute('rx','3'); bg.setAttribute('fill','var(--form-bg-color)'); bg.setAttribute('opacity','0.85'); svg.insertBefore(bg,txt); } catch(e){}
            }
            var hit=document.createElementNS(NS,'line');
            hit.setAttribute('x1',a.x); hit.setAttribute('y1',a.y); hit.setAttribute('x2',b.x); hit.setAttribute('y2',b.y);
            hit.setAttribute('stroke-width','12'); hit.setAttribute('stroke','transparent');
            hit.style.pointerEvents='all'; hit.style.cursor='pointer';
            (function(dId,srcId,tgtId){ hit.addEventListener('click',function(ev){ ev.stopPropagation(); openResConnPanel(ev,dId,srcId,tgtId); }); })(docId,id,tid);
            svg.appendChild(hit);
        });
    });
    if (dragLine) svg.appendChild(dragLine);
}
