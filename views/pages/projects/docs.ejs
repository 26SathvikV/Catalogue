// ── View mode ──────────────────────────────────────────────────────────────────
function switchViewMode(docId, mode) {
    var bysec = document.getElementById('bysec-' + docId);
    var whole = document.getElementById('whole-' + docId);
    var btnBy = document.getElementById('vmBy-' + docId);
    var btnWhole = document.getElementById('vmWhole-' + docId);
    if (!bysec || !whole) return;
    if (mode === 'whole-doc') {
        // Sync content from textareas into whole-doc view
        bysec.querySelectorAll('.sec-block').forEach(function(block) {
            var sid = block.dataset.secid;
            var ta = block.querySelector('.section-textarea');
            var wdEl = document.querySelector('#wdsec-' + sid + ' .whole-doc-content, #wdsec-' + sid + ' .whole-doc-empty');
            if (ta && wdEl) {
                if (ta.value.trim()) { wdEl.className = 'whole-doc-content'; wdEl.textContent = ta.value; }
                else { wdEl.className = 'whole-doc-empty'; wdEl.textContent = 'No content yet.'; }
            }
        });
        bysec.style.display = 'none'; whole.style.display = 'block';
        if (btnBy) btnBy.classList.remove('active');
        if (btnWhole) btnWhole.classList.add('active');
    } else {
        bysec.style.display = 'block'; whole.style.display = 'none';
        if (btnBy) btnBy.classList.add('active');
        if (btnWhole) btnWhole.classList.remove('active');
    }
}

