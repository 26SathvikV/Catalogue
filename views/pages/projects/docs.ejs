<% var name = "Docs"; %>

<style>
    /* ── Layout ──────────────────────────────────────────────────────────────── */
    .docs-layout { display: flex; height: calc(100vh - 120px); overflow: hidden; }

    /* ── Collapsible side panels ─────────────────────────────────────────────── */
    .side-panel { flex-shrink: 0; display: flex; flex-direction: column; border-right: 1px solid var(--form-border-color); overflow: hidden; transition: width 0.18s ease; }
    .side-panel.collapsed { width: 32px !important; }
    .side-panel.collapsed .panel-scroll,
    .side-panel.collapsed .panel-label { display: none; }
    .side-panel.collapsed .panel-collapse-btn::before { content: '▶'; }

    .panel-header { display: flex; align-items: center; gap: 6px; padding: 9px 10px; border-bottom: 1px solid var(--form-border-color); flex-shrink: 0; min-height: 36px; box-sizing: border-box; }
    .panel-label { flex: 1; font-size: 11px; opacity: 0.5; text-transform: uppercase; letter-spacing: 0.06em; white-space: nowrap; overflow: hidden; }
    .panel-collapse-btn { background: none; border: none; cursor: pointer; opacity: 0.4; font-size: 10px; padding: 2px 4px; color: inherit; flex-shrink: 0; line-height: 1; }
    .panel-collapse-btn:hover { opacity: 0.8; }
    .panel-collapse-btn::before { content: '◀'; }
    .panel-scroll { flex: 1; overflow-y: auto; }

    /* ── Doc list ────────────────────────────────────────────────────────────── */
    #docsNav { width: 200px; }
    .doc-nav-item { display: flex; align-items: center; gap: 6px; padding: 8px 14px; cursor: pointer; font-size: 13px; border-left: 3px solid transparent; }
    .doc-nav-item:hover { background: var(--form-bg-color); }
    .doc-nav-item.active { border-left-color: var(--link-color); font-weight: 600; }
    .doc-nav-name { flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .research-tag { font-size: 10px; opacity: 0.5; background: var(--form-border-color); padding: 1px 5px; border-radius: 6px; flex-shrink: 0; }
    .doc-nav-add { padding: 7px 14px; opacity: 0.5; font-size: 13px; cursor: pointer; }
    .doc-nav-add:hover { opacity: 1; }
    .rename-input { font-size: 13px; border: 1px solid var(--form-border-color); border-radius: 4px; padding: 1px 4px; background: var(--background-color); color: inherit; width: 110px; }

    /* ── Section list ────────────────────────────────────────────────────────── */
    #sectionsNav { width: 170px; }
    .sec-nav-item { padding: 7px 12px; font-size: 13px; cursor: pointer; border-left: 3px solid transparent; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; display: block; }
    .sec-nav-item:hover { background: var(--form-bg-color); }
    .sec-nav-item.active { border-left-color: var(--link-color); font-weight: 600; }

    /* ── Main docs body ──────────────────────────────────────────────────────── */
    .docs-body { flex: 1; display: flex; overflow: hidden; min-width: 0; }
    .docs-editor-area { flex: 1; overflow-y: auto; padding: 20px 24px; min-width: 0; }
    .docs-ref-panel { width: 230px; flex-shrink: 0; border-left: 1px solid var(--form-border-color); overflow-y: auto; padding: 14px; display: none; }
    .docs-ref-panel.open { display: block; }

    /* ── Doc meta ────────────────────────────────────────────────────────────── */
    .doc-meta { display: flex; align-items: center; gap: 10px; margin-bottom: 14px; flex-wrap: wrap; }
    .doc-title-edit { font-size: 18px; font-weight: 700; border: none; background: none; color: inherit; padding: 0; flex: 1; min-width: 0; }
    .doc-title-edit:focus { outline: 1px solid var(--form-border-color); border-radius: 4px; padding: 2px 6px; }
    .btn-ghost { background: none; border: 1px solid var(--form-border-color); border-radius: 6px; padding: 4px 10px; font-size: 12px; cursor: pointer; color: inherit; }
    .btn-ghost:hover { opacity: 0.7; }
    .btn-ghost.active { background: var(--button-bg-color); }
    .btn-danger { color: #e74c3c; border-color: #e74c3c44; }

    /* ── View mode toggle ────────────────────────────────────────────────────── */
    .view-mode-bar { display: flex; gap: 0; margin-bottom: 16px; border: 1px solid var(--form-border-color); border-radius: 6px; overflow: hidden; width: fit-content; }
    .view-mode-btn { padding: 5px 14px; font-size: 12px; cursor: pointer; border: none; background: none; color: inherit; }
    .view-mode-btn.active { background: var(--button-bg-color); }
    .view-mode-btn:not(:last-child) { border-right: 1px solid var(--form-border-color); }

    /* ── Section blocks (by-section view) ───────────────────────────────────── */
    .sec-block { border: 1px solid var(--form-border-color); border-radius: 8px; margin-bottom: 12px; overflow: hidden; scroll-margin-top: 12px; }
    .sec-block-header { display: flex; align-items: center; gap: 8px; padding: 10px 14px; background: var(--form-bg-color); font-size: 14px; font-weight: 500; cursor: pointer; user-select: none; }
    .sec-block-title { flex: 1; }
    .sec-block-body { padding: 14px; }
    .sec-block-body.hidden { display: none; }
    .section-textarea { width: 100%; box-sizing: border-box; resize: vertical; min-height: 180px; font-size: 14px; line-height: 1.6; font-family: inherit; padding: 10px 12px; border: 1px solid var(--form-border-color); border-radius: 6px; background: var(--background-color); color: inherit; }
    .save-indicator { font-size: 12px; opacity: 0.5; margin-left: 6px; }
    .word-count { font-size: 11px; opacity: 0.4; margin-top: 3px; display: block; }

    /* ── Outline panel (toggleable at bottom of each section) ───────────────── */
    .outline-panel { margin-top: 10px; border-top: 1px solid var(--form-border-color); padding-top: 10px; display: none; }
    .outline-panel.open { display: block; }
    .outline-toggle-btn { font-size: 11px; background: none; border: 1px solid var(--form-border-color); border-radius: 4px; cursor: pointer; color: inherit; padding: 2px 8px; opacity: 0.55; }
    .outline-toggle-btn:hover { opacity: 1; }
    .outline-textarea { width: 100%; box-sizing: border-box; resize: vertical; min-height: 70px; font-size: 13px; line-height: 1.5; font-family: inherit; padding: 8px 10px; border: 1px solid var(--form-border-color); border-radius: 6px; background: var(--background-color); color: inherit; }

    /* ── Whole-doc view ──────────────────────────────────────────────────────── */
    .whole-doc-view { font-size: 14px; line-height: 1.8; }
    .whole-doc-sec { margin-bottom: 32px; }
    .whole-doc-sec-title { font-size: 18px; font-weight: 700; margin: 0 0 10px; padding-bottom: 6px; border-bottom: 1px solid var(--form-border-color); }
    .whole-doc-content { white-space: pre-wrap; opacity: 0.85; margin: 0; }
    .whole-doc-empty { opacity: 0.35; font-style: italic; margin: 0; }

    /* ── Drag handle ─────────────────────────────────────────────────────────── */
    .drag-handle { cursor: grab; opacity: 0.3; font-size: 16px; padding: 0 4px; user-select: none; }
    .drag-handle:hover { opacity: 0.7; }
    .sec-block.dragging-sec { opacity: 0.4; }
    .sec-block.drag-over-sec { border-top: 2px solid var(--link-color); }

    /* ── Add section button ──────────────────────────────────────────────────── */
    .add-section-btn { font-size: 13px; opacity: 0.6; cursor: pointer; border: 1px dashed var(--form-border-color); background: none; border-radius: 6px; padding: 7px 14px; color: inherit; margin-top: 4px; width: 100%; text-align: left; }
    .add-section-btn:hover { opacity: 1; }

    /* ── Research canvas ─────────────────────────────────────────────────────── */
    .research-canvas { position: relative; min-height: 520px; background-image: radial-gradient(circle, var(--form-border-color) 1px, transparent 1px); background-size: 28px 28px; border-radius: 8px; overflow: hidden; border: 1px solid var(--form-border-color); }
    .research-card { position: absolute; width: 220px; border: 1.5px solid var(--form-border-color); border-radius: 8px; padding: 12px; background: var(--form-bg-color); cursor: grab; user-select: none; box-shadow: 0 2px 8px rgba(0,0,0,0.15); z-index: 2; }
    .research-card:active { cursor: grabbing; z-index: 10; }
    .research-card.connecting-source { box-shadow: 0 0 0 2px #4a90d9; }
    .rc-group { font-size: 10px; font-weight: bold; text-transform: uppercase; letter-spacing: 0.05em; background: var(--form-border-color); padding: 1px 6px; border-radius: 8px; display: inline-block; margin-bottom: 4px; }
    .rc-title { margin: 0 0 4px; font-size: 13px; font-weight: 600; line-height: 1.3; }
    .rc-desc { margin: 0 0 4px; font-size: 12px; opacity: 0.65; }
    .rc-content { margin: 0; font-size: 11px; opacity: 0.55; white-space: pre-wrap; max-height: 60px; overflow: hidden; }
    .rc-reflink { font-size: 11px; opacity: 0.45; margin: 4px 0 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .rc-media { max-width: 100%; max-height: 80px; border-radius: 4px; margin-top: 6px; object-fit: cover; display: block; }
    .rc-actions { display: flex; gap: 4px; margin-top: 8px; }
    .rc-btn { font-size: 11px; background: none; border: 1px solid var(--form-border-color); border-radius: 4px; padding: 2px 8px; cursor: pointer; color: inherit; opacity: 0.45; }
    .rc-btn:hover { opacity: 1; }
    .rc-connect-btn.primed { opacity: 1; color: #4a90d9; border-color: #4a90d9; }
    .res-fab { position: absolute; bottom: 16px; right: 16px; z-index: 20; width: 48px; height: 48px; border-radius: 50%; background: #27ae60; color: #fff; font-size: 26px; border: none; cursor: pointer; display: flex; align-items: center; justify-content: center; box-shadow: 0 3px 10px rgba(0,0,0,0.3); transition: background 0.15s, transform 0.1s; }
    .res-fab:hover { background: #219a52; transform: scale(1.07); }
    @keyframes marchingAnts { to { stroke-dashoffset: -20; } }
    .res-drag-line { animation: marchingAnts 0.5s linear infinite; }
    #resConnPanel { display: none; position: fixed; z-index: 300; background: var(--form-bg-color); border: 1px solid var(--form-border-color); border-radius: 8px; padding: 14px; min-width: 200px; box-shadow: 0 4px 16px rgba(0,0,0,0.2); }
    #resConnPanel label { font-size: 11px; opacity: 0.6; display: block; margin-bottom: 3px; }
    #resConnPanel .rcp-field { margin-bottom: 8px; }
    #resConnPanel input, #resConnPanel select { width: 100%; box-sizing: border-box; font-size: 12px; }

    /* ── Version panel ───────────────────────────────────────────────────────── */
    .docs-version-panel { display: none; position: fixed; right: 16px; top: 80px; width: 260px; background: var(--form-bg-color); border: 1px solid var(--form-border-color); border-radius: 8px; padding: 14px; box-shadow: 0 8px 24px rgba(0,0,0,0.2); z-index: 200; max-height: 70vh; overflow-y: auto; }

    /* ── Ref panel ───────────────────────────────────────────────────────────── */
    .ref-panel-title { font-size: 12px; opacity: 0.45; text-transform: uppercase; letter-spacing: 0.06em; margin: 14px 0 6px; }
    .ref-panel-title:first-child { margin-top: 0; }
    .ref-doc-item { font-size: 13px; padding: 4px 0; border-bottom: 1px solid var(--form-border-color); }
    .ref-doc-item:last-child { border-bottom: none; }
    .ref-proj-tag { font-size: 11px; opacity: 0.5; }

    /* ── Modals ──────────────────────────────────────────────────────────────── */
    .modal-overlay { display: none; position: fixed; inset: 0; z-index: 200; background: rgba(0,0,0,0.5); align-items: center; justify-content: center; }
    .modal-overlay.open { display: flex; }
    .modal-box { background: var(--background-color); border: 1px solid var(--form-border-color); border-radius: 10px; padding: 22px; width: 400px; max-width: 94vw; max-height: 90vh; overflow-y: auto; }
    .modal-box h3 { margin-top: 0; font-size: 16px; }
    .modal-field { margin-bottom: 10px; }
    .modal-field label { font-size: 12px; opacity: 0.6; display: block; margin-bottom: 3px; }
    .modal-field input, .modal-field textarea, .modal-field select { width: 100%; box-sizing: border-box; font-size: 13px; }
    .modal-field textarea { resize: vertical; min-height: 70px; }
    .modal-actions { display: flex; gap: 8px; justify-content: flex-end; margin-top: 14px; }
    .modal-actions button { padding: 6px 16px; cursor: pointer; font-size: 13px; }

    /* ── Folder tree ─────────────────────────────────────────────────────────── */
    .doc-nav-icon { font-size: 14px; flex-shrink: 0; cursor: pointer; opacity: 0.6; transition: opacity 0.12s; }
    .doc-nav-icon:hover { opacity: 1; }
    .folder-arrow { font-size: 9px; opacity: 0.45; flex-shrink: 0; width: 10px; user-select: none; }
    .doc-nav-folder { font-style: normal; }
    .folder-children { /* indent handled per-node via JS */ }
    .doc-nav-add-row { display: flex; gap: 0; border-top: 1px solid var(--form-border-color); }
    .doc-nav-add-btn { flex: 1; padding: 7px 8px; opacity: 0.5; font-size: 12px; cursor: pointer; text-align: center; }
    .doc-nav-add-btn:hover { opacity: 1; background: var(--form-bg-color); }
    .doc-nav-upload-zone { margin: 6px 10px; border: 1.5px dashed var(--form-border-color); border-radius: 6px; padding: 8px; text-align: center; font-size: 11px; opacity: 0.45; cursor: pointer; transition: border-color 0.15s, opacity 0.15s; }
    .doc-nav-upload-zone:hover, .doc-nav-upload-zone.drag-over { border-color: var(--link-color); opacity: 1; }

    /* ── File viewer ─────────────────────────────────────────────────────────── */
    .file-viewer { padding: 4px 0; }
    .file-viewer-topbar { display: flex; align-items: center; gap: 8px; margin-bottom: 14px; flex-wrap: wrap; }
    .file-viewer-img { max-width: 100%; border-radius: 8px; display: block; }
    .file-viewer-video, .file-viewer-audio { width: 100%; border-radius: 8px; }
    .file-viewer-pdf { width: 100%; height: 72vh; border: none; border-radius: 8px; border: 1px solid var(--form-border-color); }
    .file-viewer-generic { border: 1px solid var(--form-border-color); border-radius: 10px; padding: 32px 24px; text-align: center; }
    .file-info-row { font-size: 12px; opacity: 0.45; margin-top: 6px; }
    .file-versions { margin-top: 20px; border-top: 1px solid var(--form-border-color); padding-top: 14px; }
    .file-version-item { display: flex; align-items: center; gap: 10px; padding: 6px 0; border-bottom: 1px solid var(--form-border-color); font-size: 13px; }
    .file-version-item:last-child { border-bottom: none; }

    /* ── Icon picker ─────────────────────────────────────────────────────────── */
    .icon-picker-grid { display: grid; grid-template-columns: repeat(8, 1fr); gap: 4px; max-height: 300px; overflow-y: auto; margin-bottom: 8px; }
    .icon-picker-item { display: flex; flex-direction: column; align-items: center; gap: 2px; padding: 6px 3px; border-radius: 5px; cursor: pointer; border: 1.5px solid transparent; }
    .icon-picker-item:hover { border-color: var(--link-color); background: var(--form-bg-color); }
    .icon-picker-item.selected { border-color: var(--link-color); background: var(--form-bg-color); }
    .icon-picker-item ion-icon { font-size: 18px; }
    .icon-picker-item span { font-size: 8px; opacity: 0.45; text-align: center; line-height: 1.2; overflow: hidden; white-space: nowrap; width: 100%; text-overflow: ellipsis; }
    .icon-picker-cat { font-size: 10px; opacity: 0.4; text-transform: uppercase; letter-spacing: 0.06em; margin: 10px 0 4px; font-weight: 600; }
</style>

<div class="docs-layout">

    <!-- ── Doc list sidebar ──────────────────────────────────────────────────── -->
    <div class="side-panel" id="docsNav">
        <div class="panel-header">
            <span class="panel-label">Documents</span>
            <button class="panel-collapse-btn" onclick="togglePanel('docsNav')" title="Collapse"></button>
        </div>
        <div class="panel-scroll">
            <!-- JS-rendered tree goes here -->
            <div id="docTreeRoot"></div>
            <div class="doc-nav-add-row">
                <div class="doc-nav-add-btn" onclick="showNewDocModal()">+ Doc</div>
                <div class="doc-nav-add-btn" onclick="createFolder()" title="Create folder"><ion-icon name="folder-outline" aria-hidden="true"></ion-icon></div>
                <div class="doc-nav-add-btn" onclick="document.getElementById('fileUploadInput').click()" title="Upload file">↑</div>
            </div>
            <!-- Hidden file input for uploads -->
            <input type="file" id="fileUploadInput" style="display:none;" multiple onchange="handleFileUpload(this.files, null)">
            <!-- Drag-to-upload zone -->
            <div class="doc-nav-upload-zone" id="docUploadZone"
                 onclick="document.getElementById('fileUploadInput').click()"
                 ondragover="event.preventDefault(); this.classList.add('drag-over')"
                 ondragleave="this.classList.remove('drag-over')"
                 ondrop="this.classList.remove('drag-over'); handleFileUpload(event.dataTransfer.files, null); event.preventDefault()">
                Drop files to upload
            </div>
            <div style="padding:8px 14px; border-top:1px solid var(--form-border-color);">
                <div onclick="toggleImportPanel()" style="font-size:11px; opacity:0.55; cursor:pointer; padding:3px 0;">↑ Import (md/docx/zip)</div>
                <div id="importPanel" style="display:none; margin-top:6px;">
                    <input type="file" id="importFile" accept=".md,.zip,.docx" style="font-size:11px; width:100%; margin-bottom:6px;">
                    <button onclick="importDoc()" style="width:100%; font-size:12px;">Import</button>
                    <p id="importStatus" style="font-size:11px; opacity:0.6; margin:4px 0 0;"></p>
                </div>
            </div>
        </div>
    </div>

    <!-- ── Section list sidebar ──────────────────────────────────────────────── -->
    <div class="side-panel" id="sectionsNav">
        <div class="panel-header">
            <span class="panel-label">Sections</span>
            <button class="panel-collapse-btn" onclick="togglePanel('sectionsNav')" title="Collapse"></button>
        </div>
        <div class="panel-scroll" id="sectionsNavList">
            <p style="font-size:12px; opacity:0.4; padding:12px;">No doc open</p>
        </div>
    </div>

    <!-- ── Main editor + reference panel ─────────────────────────────────────── -->
    <div class="docs-body">
        <div class="docs-editor-area" id="docsEditorArea">

            <% if (docs.length === 0) { %>
                <p style="opacity:0.45; margin-top:60px; text-align:center;">No documents yet. Create one in the sidebar.</p>
            <% } %>

            <% docs.forEach(function(doc, di) { %>
            <div class="doc-view" id="docview-<%= doc._id %>" style="display:none;">

                <!-- Title + buttons -->
                <div class="doc-meta">
                    <input type="text" class="doc-title-edit" value="<%= doc.title %>"
                           onblur="renameDoc('<%= doc._id %>', this.value)"
                           onkeydown="if(event.key==='Enter')this.blur()">
                    <% if (doc.isResearch) { %><span class="research-tag">Research</span><% } %>
                    <button type="button" class="btn-ghost" onclick="toggleRefPanel()">References</button>
                    <button type="button" class="btn-ghost" onclick="toggleVersionPanel('<%= doc._id %>')">History</button>
                    <button type="button" class="btn-ghost btn-danger"
                            onclick="showDeleteConfirm('/projects/<%= projectId %>/docs/<%= doc._id %>/delete', 'Delete this document? This cannot be undone.')">
                        Delete
                    </button>
                </div>

                <!-- Version history floating panel -->
                <div class="docs-version-panel" id="versionPanel-<%= doc._id %>">
                    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:10px;">
                        <span style="font-size:12px; font-weight:600;">Version History</span>
                        <button onclick="toggleVersionPanel('<%= doc._id %>')" class="btn-ghost" style="padding:2px 6px; font-size:11px;">✕</button>
                    </div>
                    <% doc.sections.forEach(function(sec) { %>
                        <% if (sec.versions && sec.versions.length > 0) { %>
                            <p style="font-size:11px; font-weight:600; opacity:0.5; margin:10px 0 4px;"><%= sec.title %></p>
                            <% sec.versions.slice().reverse().forEach(function(v, vi) { %>
                                <div style="border:1px solid var(--form-border-color); border-radius:6px; padding:7px 10px; margin-bottom:5px; font-size:12px;">
                                    <div style="opacity:0.6;"><%= v.savedBy || 'Unknown' %> · <span class="humanized-date" data-date="<%= v.savedAt ? new Date(v.savedAt).toISOString() : '' %>"></span></div>
                                    <div style="opacity:0.75; margin-top:2px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; max-width:200px;"><%= (v.content || v.outline || '').substring(0,60) %>…</div>
                                    <button onclick="restoreVersion('<%= sec._id %>','<%= doc._id %>',<%= sec.versions.length - 1 - vi %>)" class="btn-ghost" style="margin-top:5px; font-size:11px; padding:2px 8px;">Restore</button>
                                </div>
                            <% }) %>
                        <% } %>
                    <% }) %>
                    <% if (!doc.sections.some(function(s){ return s.versions && s.versions.length > 0; })) { %>
                        <p style="font-size:12px; opacity:0.45;">No saved versions yet.</p>
                    <% } %>
                </div>

                <% if (doc.docType === 'file') { %>

                    <!-- File viewer -->
                    <div class="file-viewer" id="fileviewer-<%= doc._id %>">
                        <div class="file-viewer-topbar">
                            <button type="button" class="btn-ghost" onclick="document.getElementById('versionUploadInput-<%= doc._id %>').click()">↑ Upload new version</button>
                            <input type="file" id="versionUploadInput-<%= doc._id %>" style="display:none;" onchange="uploadNewVersion('<%= doc._id %>', this.files[0])">
                            <% var convertableMimes = ['application/pdf', 'text/markdown', 'text/plain', 'application/vnd.openxmlformats-officedocument.wordprocessingml.document']; %>
                            <% var isConvertable = (doc.mimeType && convertableMimes.indexOf(doc.mimeType) !== -1) || (doc.fileName && /\.(md|docx|pdf|txt)$/i.test(doc.fileName)); %>
                            <% if (isConvertable) { %>
                                <button type="button" class="btn-ghost" onclick="convertToDoc('<%= doc._id %>')">Convert to Catalogue Doc</button>
                            <% } %>
                            <% if (doc.fileUrl) { %>
                                <a href="<%= doc.fileUrl %>" download="<%= doc.fileName %>" class="btn-ghost" style="text-decoration:none;">↓ Download</a>
                            <% } %>
                        </div>

                        <% if (doc.mimeType && doc.mimeType.startsWith('image/')) { %>
                            <img class="file-viewer-img" src="<%= doc.fileUrl %>" alt="<%= doc.fileName || '' %>">
                        <% } else if (doc.mimeType && doc.mimeType.startsWith('video/')) { %>
                            <video class="file-viewer-video" controls>
                                <source src="<%= doc.fileUrl %>" type="<%= doc.mimeType %>">
                                Your browser does not support video playback.
                            </video>
                        <% } else if (doc.mimeType && doc.mimeType.startsWith('audio/')) { %>
                            <audio class="file-viewer-audio" controls>
                                <source src="<%= doc.fileUrl %>" type="<%= doc.mimeType %>">
                            </audio>
                        <% } else if (doc.mimeType === 'application/pdf') { %>
                            <iframe class="file-viewer-pdf" src="<%= doc.fileUrl %>"></iframe>
                        <% } else { %>
                            <div class="file-viewer-generic">
                                <ion-icon name="<%= doc.icon || 'attach-outline' %>" style="font-size:52px; opacity:0.35;"></ion-icon>
                                <p style="font-size:15px; font-weight:500; margin:12px 0 4px;"><%= doc.fileName || doc.title %></p>
                                <% if (doc.fileSize) { %><p class="file-info-row"><%= (doc.fileSize / 1024 / 1024).toFixed(2) %> MB</p><% } %>
                                <% if (doc.fileUrl) { %>
                                    <a href="<%= doc.fileUrl %>" download="<%= doc.fileName %>" class="btn-ghost" style="display:inline-block; margin-top:14px; text-decoration:none;">↓ Download file</a>
                                <% } %>
                            </div>
                        <% } %>

                        <% if (doc.fileUrl) { %>
                            <p class="file-info-row">
                                <%= doc.fileName || '' %>
                                <% if (doc.mimeType) { %>&nbsp;·&nbsp;<%= doc.mimeType %><% } %>
                                <% if (doc.fileSize) { %>&nbsp;·&nbsp;<%= (doc.fileSize / 1024 / 1024).toFixed(2) %> MB<% } %>
                            </p>
                        <% } %>

                        <% if (doc.fileVersions && doc.fileVersions.length > 0) { %>
                            <div class="file-versions">
                                <p style="font-size:12px; opacity:0.45; margin:0 0 8px; font-weight:600;">Previous Versions</p>
                                <% doc.fileVersions.slice().reverse().forEach(function(v, vi) { %>
                                    <div class="file-version-item">
                                        <span style="flex:1; opacity:0.7; font-size:12px;"><%= v.name || ('Version ' + (doc.fileVersions.length - vi)) %></span>
                                        <% if (v.size) { %><span style="opacity:0.4; font-size:11px;"><%= (v.size / 1024).toFixed(0) %> KB</span><% } %>
                                        <a href="<%= v.url %>" download class="btn-ghost" style="font-size:11px; padding:2px 8px; text-decoration:none;">↓</a>
                                    </div>
                                <% }) %>
                            </div>
                        <% } %>
                    </div>

                <% } else if (!doc.isResearch) { %>

                    <!-- View mode toggle -->
                    <div class="view-mode-bar">
                        <button class="view-mode-btn active" id="vmBy-<%= doc._id %>"
                                onclick="switchViewMode('<%= doc._id %>', 'by-section')">By Section</button>
                        <button class="view-mode-btn" id="vmWhole-<%= doc._id %>"
                                onclick="switchViewMode('<%= doc._id %>', 'whole-doc')">Whole Doc</button>
                    </div>

                    <!-- By-section view -->
                    <div id="bysec-<%= doc._id %>">
                        <% if (doc.sections.length === 0) { %>
                            <p style="opacity:0.45; font-size:13px;" id="nosec-<%= doc._id %>">No sections yet. Add one below.</p>
                        <% } %>
                        <% doc.sections.forEach(function(sec) { %>
                            <div class="sec-block" id="sec-<%= sec._id %>" data-secid="<%= sec._id %>">
                                <div class="sec-block-header" onclick="toggleSecBlock(this)">
                                    <span class="drag-handle" onclick="event.stopPropagation()">⠿</span>
                                    <span class="sec-block-title"><%= sec.title %></span>
                                    <button class="outline-toggle-btn" type="button"
                                            onclick="event.stopPropagation(); toggleOutlinePanel('<%= sec._id %>')">Outline</button>
                                    <button class="btn-ghost btn-danger" type="button" style="padding:2px 6px; font-size:11px;"
                                            onclick="event.stopPropagation(); showDeleteConfirm('/projects/<%= projectId %>/docs/<%= doc._id %>/sections/<%= sec._id %>/delete', 'Delete this section?')">✕</button>
                                </div>
                                <div class="sec-block-body">
                                    <textarea class="section-textarea" style="min-height:200px;"
                                              placeholder="Write your content here..."
                                              oninput="autoSave('save','<%= projectId %>','<%= doc._id %>','<%= sec._id %>',this); updateWordCount('<%= sec._id %>', this.value)"><%= sec.content || '' %></textarea>
                                    <div style="display:flex; align-items:center; gap:8px;">
                                        <span class="word-count" id="wc-<%= sec._id %>">0 words</span>
                                        <span class="save-indicator" id="si-save-<%= sec._id %>"></span>
                                    </div>
                                    <!-- Outline panel (toggleable) -->
                                    <div class="outline-panel" id="outline-panel-<%= sec._id %>">
                                        <p style="font-size:11px; opacity:0.5; margin:0 0 5px;">Section Outline</p>
                                        <textarea class="outline-textarea"
                                                  placeholder="Planning notes for this section..."
                                                  oninput="autoSave('outline','<%= projectId %>','<%= doc._id %>','<%= sec._id %>',this)"><%= sec.outline || '' %></textarea>
                                        <span class="save-indicator" id="si-outline-<%= sec._id %>"></span>
                                    </div>
                                </div>
                            </div>
                        <% }) %>
                        <button type="button" class="add-section-btn"
                                onclick="showAddSecModal('<%= doc._id %>')">+ Add Section</button>
                    </div>

                    <!-- Whole-doc view (populated dynamically) -->
                    <div id="whole-<%= doc._id %>" style="display:none;" class="whole-doc-view">
                        <p style="font-size:12px; opacity:0.4; margin:0 0 18px;">Read-only · switch to By Section to edit</p>
                        <% doc.sections.forEach(function(sec) { %>
                            <div class="whole-doc-sec" id="wdsec-<%= sec._id %>">
                                <h3 class="whole-doc-sec-title"><%= sec.title %></h3>
                                <% if (sec.content && sec.content.trim()) { %>
                                    <p class="whole-doc-content"><%= sec.content %></p>
                                <% } else { %>
                                    <p class="whole-doc-empty">No content yet.</p>
                                <% } %>
                            </div>
                        <% }) %>
                        <% if (doc.sections.length === 0) { %>
                            <p style="opacity:0.45;">No sections yet.</p>
                        <% } %>
                    </div>

                <% } else { %>

                    <!-- Research canvas -->
                    <div class="research-canvas" id="resCanvas-<%= doc._id %>">
                        <svg id="researchSvg-<%= doc._id %>" style="position:absolute;inset:0;width:100%;height:100%;pointer-events:none;overflow:visible;">
                            <line id="resDragLine-<%= doc._id %>" class="res-drag-line"
                                  x1="0" y1="0" x2="0" y2="0"
                                  stroke="#4a90d9" stroke-width="2" stroke-dasharray="6,4"
                                  visibility="hidden" pointer-events="none"/>
                        </svg>
                        <% doc.sections.forEach(function(sec, si) { %>
                            <div class="research-card"
                                 id="rsec-<%= sec._id %>"
                                 data-id="<%= sec._id %>"
                                 data-docid="<%= doc._id %>"
                                 data-conns='<%= JSON.stringify((sec.connections || []).filter(function(c){ return c.targetId; }).map(function(c){ return { targetId: c.targetId.toString(), color: c.color||"#4a90d9", width: c.width||1.5, lineStyle: c.lineStyle||"solid", symbol: c.symbol||"none", label: c.label||"" }; })) %>'
                                 data-title="<%= encodeURIComponent(sec.title || '') %>"
                                 data-desc="<%= encodeURIComponent(sec.description || '') %>"
                                 data-group="<%= encodeURIComponent(sec.group || '') %>"
                                 data-content="<%= encodeURIComponent(sec.content || '') %>"
                                 data-reflink="<%= encodeURIComponent(sec.refLink || '') %>"
                                 data-mediaurl="<%= sec.mediaUrl || '' %>"
                                 style="left:<%= (si % 3) * 240 + 20 %>px; top:<%= Math.floor(si / 3) * 190 + 20 %>px;">
                                <% if (sec.group) { %><span class="rc-group"><%= sec.group %></span><% } %>
                                <p class="rc-title"><%= sec.title %></p>
                                <% if (sec.description) { %><p class="rc-desc"><%= sec.description %></p><% } %>
                                <% if (sec.content || sec.outline) { %><p class="rc-content"><%= (sec.content || sec.outline || '').substring(0, 120) %></p><% } %>
                                <% if (sec.refLink) { %><p class="rc-reflink"><%= sec.refLink %></p><% } %>
                                <% if (sec.mediaUrl) { %><img class="rc-media" src="<%= sec.mediaUrl %>" alt=""><% } %>
                                <div class="rc-actions">
                                    <button class="rc-btn rc-connect-btn" type="button"
                                            onmousedown="startResConnDrag(event,'<%= sec._id %>','<%= doc._id %>')">⬤</button>
                                    <button class="rc-btn" type="button"
                                            onclick="event.stopPropagation(); openEditResCard('<%= sec._id %>','<%= doc._id %>')">Edit</button>
                                    <button class="rc-btn" type="button"
                                            onclick="event.stopPropagation(); showDeleteConfirm('/projects/<%= projectId %>/docs/<%= doc._id %>/sections/<%= sec._id %>/delete', 'Delete this card?')">✕</button>
                                </div>
                            </div>
                        <% }) %>
                        <button class="res-fab" type="button"
                                onclick="showAddResCardModal('<%= doc._id %>')"
                                title="Add Research Card">+</button>
                    </div>
                    <div style="margin-top:10px; display:flex; gap:8px; flex-wrap:wrap;">
                        <button type="button" class="btn-ghost"
                                id="resConnBtn-<%= doc._id %>"
                                onclick="toggleResConnect('<%= doc._id %>', this)">Connect Cards</button>
                        <button type="button" class="btn-ghost"
                                onclick="autoOrganize('<%= doc._id %>')">Auto-Organize</button>
                    </div>

                <% } /* end file/doc/research if-chain */ %>
            </div>
            <% }) %>

        </div>

        <!-- Reference panel -->
        <div class="docs-ref-panel" id="refPanel">
            <p class="ref-panel-title">This Project's Docs</p>
            <% docs.forEach(function(d) { %>
                <div class="ref-doc-item">
                    <strong><%= d.title %></strong><% if (d.isResearch) { %> <span class="ref-proj-tag">research</span><% } %>
                    <% d.sections.forEach(function(s) { %>
                        <div style="font-size:12px; padding:1px 0 1px 10px; opacity:0.65;"><%= s.title %></div>
                    <% }) %>
                </div>
            <% }) %>
            <% if (relatedDocs.length > 0) { %>
                <p class="ref-panel-title">Related Projects</p>
                <% relatedDocs.forEach(function(rd) { %>
                    <div class="ref-doc-item">
                        <strong><%= rd.docTitle %></strong><br>
                        <span class="ref-proj-tag"><%= rd.projectName %></span>
                    </div>
                <% }) %>
            <% } %>
        </div>
    </div>
</div>

<!-- Research connection panel -->
<div id="resConnPanel">
    <div style="font-size:11px; opacity:0.5; margin-bottom:10px; text-transform:uppercase; letter-spacing:0.05em;">Connection</div>
    <div class="rcp-field"><label>Color</label><input type="color" id="rcpColor" oninput="resConnLivePreview()"></div>
    <div class="rcp-field"><label>Width</label><input type="range" id="rcpWidth" min="1" max="6" step="0.5" oninput="resConnLivePreview()"></div>
    <div class="rcp-field"><label>Style</label>
        <select id="rcpStyle" onchange="resConnLivePreview()">
            <option value="solid">Solid</option><option value="dashed">Dashed</option><option value="dotted">Dotted</option>
        </select>
    </div>
    <div class="rcp-field"><label>Midpoint Symbol</label>
        <select id="rcpSymbol" onchange="resConnLivePreview()">
            <option value="none">None</option><option value="circle">Circle ●</option><option value="triangle">Triangle ▲</option>
            <option value="square">Square ■</option><option value="diamond">Diamond ◆</option><option value="hexagon">Hexagon ⬡</option>
            <option value="star">Star ★</option><option value="plus">Plus ✚</option><option value="x">X ✕</option><option value="arrow">Arrow ➤</option>
        </select>
    </div>
    <div class="rcp-field" style="margin-bottom:12px;"><label>Label</label><input type="text" id="rcpLabel" placeholder="Optional..." oninput="resConnLivePreview()"></div>
    <div style="display:flex; gap:6px;">
        <button type="button" onclick="saveResConnProps()" style="flex:1; font-size:12px; padding:5px;">Save</button>
        <button type="button" onclick="disconnectResConn()" style="font-size:12px; padding:5px; color:#e74c3c; border-color:#e74c3c44; border:1px solid; border-radius:4px; background:none; cursor:pointer;">Remove</button>
        <button type="button" onclick="closeResConnPanel()" style="font-size:12px; padding:5px; background:none; border:1px solid var(--form-border-color); border-radius:4px; cursor:pointer; color:inherit;">✕</button>
    </div>
</div>

