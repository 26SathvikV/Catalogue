<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Catalogue - Sign Up</title>
    <link rel="stylesheet" href="/style.css">
    <style>
        .color-scheme-dropdown {
            margin: 20px 0;
            text-align: center;
        }

        .color-scheme-dropdown select {
            padding: 10px 20px;
            font-size: 16px;
            border-radius: 5px;
            cursor: pointer;
        }

        h1, h2, h3, p {
            margin: 0.5em 0;
        }

        body, html {
            height: 100%;
            width: 100%;
            margin: 0;
            display: flex;
            justify-content: center;
            align-items: center;
            font-family: 'Arial', sans-serif;
        }
    </style>
</head>
<body>
    <main style="padding: 35px 100px;height: 100%;width: 100%;display: flex;justify-content: center;align-items: center;">
        <button style="position:absolute;right:2%;top:2%;width:10%;" onclick="window.location.replace('/signup')">Sign Up</button>

        <form class="middleform" method="POST" action="/login">
            <input type="text" id="email" name="email" placeholder="Email" autocomplete="email"/> <br>
            <input type="password" id="pass" name="pass" placeholder="Password" autocomplete="current-password"/> <br>
            <button type="submit" id="input">Log In</button>
        </form>

        <div style="text-align:center; margin-top:16px; font-size:13px; opacity:0.5;"> or </div>
        <a href="/auth/google" style="display:flex; align-items:center; justify-content:center; gap:10px; margin:12px auto 0; max-width:260px; padding:9px 16px; background:#fff; color:#333; border:1px solid #ccc; border-radius:6px; text-decoration:none; font-size:14px;">
            <svg width="18" height="18" viewBox="0 0 48 48"><path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.08 17.74 9.5 24 9.5z"/><path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/><path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/><path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.18 1.48-4.97 2.31-8.16 2.31-6.26 0-11.57-3.59-13.46-8.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/></svg>
            Sign in with Google
        </a>
    </main>

