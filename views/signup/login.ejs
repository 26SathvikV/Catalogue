        function applyColorScheme(scheme) {
            for (let key in scheme) {
                document.documentElement.style.setProperty(key, scheme[key]);
            }
        }

        function setColorSchemeFromLocalStorage() {
            const savedScheme = localStorage.getItem('colorScheme');
            if (savedScheme && schemes[savedScheme]) {
                applyColorScheme(schemes[savedScheme]);
            } else {
                applyColorScheme(darkScheme);
            }
        }

        setColorSchemeFromLocalStorage();

        window.addEventListener('DOMContentLoaded', (event) => {
            const navLinks = document.querySelectorAll('nav a');

            navLinks.forEach(link => {
                if (link.href === window.location.href) {
                    link.style.fontWeight = 'bold';
                    link.style.pointerEvents = 'none';
                }
            });
        });
    </script>
</body>
</html>
