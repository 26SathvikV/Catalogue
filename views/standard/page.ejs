    <!-- Site switcher popup -->
    <div id="siteSwitcher" role="dialog" aria-label="App Switcher" style="display:none; position:absolute; top:66px; left:6px; min-width:240px; background:var(--form-bg-color); border:1px solid var(--form-border-color); border-radius:10px; padding:16px; box-shadow:0 8px 32px rgba(0,0,0,0.25); z-index:600;">
        <div class="sites-grid" id="siteSwitcherGrid">
            <div style="color:var(--link-color);font-size:0.8rem;grid-column:1/-1">Loading…</div>
        </div>
        <hr class="sites-divider">
        <a href="/logout" class="sites-logout">Logout</a>
    </div>

    <script>
    let _sitesLoaded = false;

    window.toggleSiteSwitcher = function(e) {
        if (e) e.stopPropagation();
        var popup = document.getElementById('siteSwitcher');
        if (!popup) return;
        var isOpen = popup.style.display !== 'none';
        popup.style.display = isOpen ? 'none' : 'block';
        if (!isOpen && !_sitesLoaded) loadSites();
    };

    async function loadSites() {
        _sitesLoaded = true;
        var grid = document.getElementById('siteSwitcherGrid');
        try {
            var sites = await fetch('/api/websites').then(function(r){ return r.json(); });
            if (!Array.isArray(sites) || !sites.length) {
                grid.innerHTML = '<div style="color:var(--link-color);font-size:0.8rem;grid-column:1/-1">No apps yet.</div>';
                return;
            }
            grid.innerHTML = sites.map(function(site) {
                var href = /^https?:\/\//i.test(site.link || '') ? site.link : 'https://' + site.link;
                return '<a href="' + href + '" class="site-item" title="' + (site.site_name || '') + '">' +
                    '<ion-icon name="' + (site.icon || 'globe-outline') + '" style="color:' + (site.color || '#000000') + ';font-size:2rem;"></ion-icon>' +
                    '<span class="site-label">' + (site.site_name || '') + '</span>' +
                    '</a>';
            }).join('');
        } catch(err) {
            grid.innerHTML = '<div style="color:#ff6b6b;font-size:0.8rem;grid-column:1/-1">Could not load apps.</div>';
        }
    }

    document.addEventListener('click', function(e) {
        var btn   = document.getElementById('siteSwitcherBtn');
        var popup = document.getElementById('siteSwitcher');
        if (popup && btn && !btn.contains(e.target) && !popup.contains(e.target))
            popup.style.display = 'none';
    });
    </script>

    <script src="https://cdn.jsdelivr.net/npm/moment@2.29.1/moment.min.js"></script>
    <script type="module" src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.esm.js"></script>
    <script nomodule src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.js"></script>

    <script>
    // Set favicon from database icon + color; reveal Studio nav links
    fetch('/api/self').then(function(r){ return r.json(); }).then(function(s) {
        if (s.plan === 'studio') {
            var wsLink = document.getElementById('wsNavLink');
            if (wsLink) wsLink.style.display = '';
        }
        if (!s.icon) return;
        fetch('https://unpkg.com/ionicons@7.1.0/dist/ionicons/svg/' + s.icon + '.svg')
            .then(function(r){ return r.text(); })
            .then(function(svg) {
                var col = s.color || '#888888';
                var colored = svg.replace(/<svg /, '<svg fill="' + col + '" ');
                var uri = 'data:image/svg+xml;base64,' + btoa(colored);
                var link = document.getElementById('dynFavicon');
                if (link) link.href = uri;
            }).catch(function(){});
    }).catch(function(){});

    // Notification badge
    fetch('/api/notifications/unread-count').then(function(r){ return r.json(); }).then(function(d) {
        var badge = document.getElementById('notifBadge');
        if (!badge || !d.count) return;
        badge.style.display = 'flex';
        badge.textContent = d.count > 99 ? '99+' : d.count;
    }).catch(function(){});
    </script>

