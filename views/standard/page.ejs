<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Catalogue - <%- name %></title>
    <link rel="icon" id="dynFavicon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg'/>">
    <link rel="stylesheet" href="/style.css">
    <style>
        .color-scheme-dropdown {
            margin: 20px 0;
            text-align: center;
        }

        .site-switcher-btn-wrap {
            margin: 20px 0;
            text-align: center;
            width: 10%;
            position: absolute;
            left: 1%;
        }

        .color-scheme-dropdown select {
            padding: 10px 20px;
            font-size: 16px;
            border-radius: 5px;
            cursor: pointer;
        }

        /* ── App switcher popup ── */
        #siteSwitcherBtn {
            padding: 6px 12px; font-size: 18px;
            letter-spacing: 2px; cursor: pointer;
            background: transparent;
            border: 1px solid var(--form-border-color);
            color: var(--text-color); border-radius: 6px;
            width: 100%;
        }
        #siteSwitcherBtn:hover { background: var(--form-bg-color); }
        .sites-grid {
            display: grid; grid-template-columns: repeat(3, 1fr);
            gap: 12px; margin-bottom: 12px;
        }
        .site-item {
            text-decoration: none; text-align: center;
            color: var(--text-color); padding: 8px 4px;
            border-radius: 8px; transition: background 0.15s;
            display: flex; flex-direction: column; align-items: center; gap: 4px;
        }
        .site-item:hover { background: var(--code-bg-color); }
        .site-label { font-size: 0.68rem; }
        .sites-divider {
            border: none; border-top: 1px solid var(--form-border-color);
            margin: 8px 0;
        }
        .sites-logout { font-size: 0.82rem; color: var(--link-color); text-decoration: none; display: block; padding: 2px 0; }
        .sites-logout:hover { text-decoration: underline; }

        h1, h2, h3, p {
            margin: 0.5em 0;
        }

        body, html {
            height: 100%;
            width: 100%;
            margin: 0;
            font-family: 'Arial', sans-serif;
        }

        /* ── Responsive ── */
        @media (max-width: 700px) {
            .site-switcher-btn-wrap { width: 18%; left: 1%; }
            .color-scheme-dropdown select { padding: 6px 8px; font-size: 13px; }
            main { padding: 20px 16px !important; }
            nav center { display: flex; flex-wrap: wrap; justify-content: center; gap: 4px; }
            nav a { font-size: 13px; }
            #siteSwitcher { left: 0; right: 0; width: auto; margin: 0 8px; position: fixed; top: 66px; }
        }

        /* Toast notifications */
        #toastContainer { position:fixed; bottom:24px; right:24px; z-index:9999; display:flex; flex-direction:column; gap:8px; pointer-events:none; }
        .toast { background:var(--form-bg-color); border:1px solid var(--form-border-color); border-radius:8px; padding:10px 16px; font-size:13px; box-shadow:0 4px 16px rgba(0,0,0,0.2); opacity:0; transform:translateY(12px); transition:opacity 0.25s, transform 0.25s; pointer-events:auto; max-width:300px; display:flex; align-items:center; gap:8px; }
        .toast.show { opacity:1; transform:translateY(0); }
        .toast.success { border-left:3px solid #27ae60; }
        .toast.error   { border-left:3px solid #e74c3c; }
        .toast.info    { border-left:3px solid var(--link-color); }
        /* Notification bell */
        .notif-bell-wrap { position:relative; display:inline-flex; align-items:center; }
        .notif-badge { position:absolute; top:-6px; right:-8px; background:#e74c3c; color:#fff; border-radius:50%; font-size:10px; font-weight:700; min-width:16px; height:16px; display:flex; align-items:center; justify-content:center; padding:0 3px; pointer-events:none; display:none; }
    </style>
</head>
