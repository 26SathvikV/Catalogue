        function applyColorScheme(scheme) {
            for (let key in scheme) {
                document.documentElement.style.setProperty(key, scheme[key]);
            }
        }

        function setColorSchemeFromLocalStorage() {
            const savedScheme = localStorage.getItem('colorScheme');
            if (savedScheme && schemes[savedScheme]) {
                applyColorScheme(schemes[savedScheme]);
                document.getElementById('colorSchemeSelect').value = savedScheme;
                if (localStorage.getItem('cookieConsent') === 'accepted') {
                    document.cookie = 'colorScheme=' + savedScheme + '; path=/; max-age=31536000; SameSite=Lax';
                }
            } else {
                applyColorScheme(darkScheme);
                document.getElementById('colorSchemeSelect').value = 'darkScheme';
            }
        }

        document.getElementById('colorSchemeSelect').addEventListener('change', function() {
            const selectedScheme = this.value;
            localStorage.setItem('colorScheme', selectedScheme);
            if (localStorage.getItem('cookieConsent') === 'accepted') {
                document.cookie = 'colorScheme=' + selectedScheme + '; path=/; max-age=31536000; SameSite=Lax';
            }
            applyColorScheme(schemes[selectedScheme]);
        });

        setColorSchemeFromLocalStorage();

        function setCookieConsent(decision) {
            localStorage.setItem('cookieConsent', decision);
            document.getElementById('cookieBanner').style.display = 'none';
            if (decision === 'accepted') {
                const s = localStorage.getItem('colorScheme') || 'darkScheme';
                document.cookie = 'colorScheme=' + s + '; path=/; max-age=31536000; SameSite=Lax';
            } else {
                document.cookie = 'colorScheme=; path=/; max-age=0; SameSite=Lax';
            }
        }

        if (!localStorage.getItem('cookieConsent')) {
            document.getElementById('cookieBanner').style.display = 'flex';
        }

        window.addEventListener('DOMContentLoaded', (event) => {
            const navLinks = document.querySelectorAll('nav a');
            navLinks.forEach(link => {
                if (link.href === window.location.href) {
                    link.style.fontWeight = 'bold';
                    link.style.pointerEvents = 'none';
                }
            });
        });
    </script>

    <div id="cookieBanner" style="display:none;position:fixed;bottom:0;left:0;right:0;background-color:var(--form-bg-color);border-top:1px solid var(--form-border-color);padding:12px 24px;z-index:999;align-items:center;gap:16px;font-size:0.85rem;">
        <span style="flex:1;color:var(--text-color);">This app uses a preference cookie to sync your color theme between apps. It is not used for tracking or advertising.</span>
        <button onclick="setCookieConsent('accepted')" style="padding:6px 16px;font-size:0.85rem;flex-shrink:0;">Accept</button>
        <button onclick="setCookieConsent('declined')" style="background:transparent;border:1px solid var(--form-border-color);color:var(--text-color);padding:6px 16px;font-size:0.85rem;flex-shrink:0;">Decline</button>
    </div>

    <div id="toastContainer"></div>

    <script>
    window.showToast = function(msg, type, duration) {
        type = type || 'info'; duration = duration || 3000;
        var t = document.createElement('div');
        t.className = 'toast ' + type;
        t.textContent = msg;
        document.getElementById('toastContainer').appendChild(t);
        requestAnimationFrame(function() { requestAnimationFrame(function() { t.classList.add('show'); }); });
        setTimeout(function() {
            t.classList.remove('show');
            setTimeout(function() { t.remove(); }, 300);
        }, duration);
    };

    (function(){
        var pLoaded = false;
        window.toggleProjSwitcher = async function(e) {
            e.stopPropagation();
            var sw = document.getElementById('projSwitcher');
            var open = sw.style.display !== 'none';
            sw.style.display = open ? 'none' : 'block';
            if (!open && !pLoaded) {
                pLoaded = true;
                try {
                    var projects = await fetch('/api/projects/recent').then(r=>r.json());
                    var list = document.getElementById('projSwitcherList');
                    if (!projects.length) { list.innerHTML = '<div style="font-size:12px;opacity:0.5;padding:4px 6px;">No projects yet</div>'; return; }
                    list.innerHTML = projects.map(p =>
                        '<a href="/projects/'+p._id+'" style="display:flex;align-items:center;gap:8px;padding:6px 8px;border-radius:6px;font-size:13px;text-decoration:none;color:inherit;" onmouseover="this.style.background=\'var(--form-border-color)22\'" onmouseout="this.style.background=\'\'">'+
                        (p.color ? '<span style="width:8px;height:8px;border-radius:50%;background:'+p.color+';flex-shrink:0;display:inline-block;"></span>' : '')+
                        '<span>'+p.name+'</span></a>'
                    ).join('');
                } catch(e2) {}
            }
        };
        document.addEventListener('click', function(e) {
            if (!e.target.closest('#projSwitcher') && !e.target.closest('#projSwitcherBtn'))
                document.getElementById('projSwitcher').style.display = 'none';
        });
    })();

    (async function() {
        try {
            var bd = await fetch('/api/me/birthday').then(r=>r.json());
            if (bd && bd.isBirthday) {
                // Confetti burst
                var canvas = document.createElement('canvas');
                canvas.style.cssText = 'position:fixed;inset:0;width:100%;height:100%;pointer-events:none;z-index:9998;';
                document.body.appendChild(canvas);
                var ctx = canvas.getContext('2d');
                canvas.width = window.innerWidth; canvas.height = window.innerHeight;
                var particles = Array.from({length:120}, function() { return {
                    x: Math.random()*canvas.width, y: -10,
                    vx: (Math.random()-0.5)*4, vy: Math.random()*3+2,
                    color: ['#e74c3c','#f39c12','#27ae60','#3498db','#9b59b6','#e91e63'][Math.floor(Math.random()*6)],
                    r: Math.random()*6+3, a: Math.random()*Math.PI*2
                }; });
                var frame = 0;
                function drawConfetti() {
                    ctx.clearRect(0,0,canvas.width,canvas.height);
                    particles.forEach(function(p) {
                        p.x += p.vx; p.y += p.vy; p.a += 0.05;
                        ctx.save(); ctx.translate(p.x, p.y); ctx.rotate(p.a);
                        ctx.fillStyle = p.color; ctx.fillRect(-p.r/2,-p.r/2,p.r,p.r);
                        ctx.restore();
                    });
                    particles = particles.filter(function(p) { return p.y < canvas.height+20; });
                    if (frame++ < 180 && particles.length) requestAnimationFrame(drawConfetti);
                    else canvas.remove();
                }
                drawConfetti();
                showToast('Happy Birthday, ' + bd.name + '!', 'success', 6000);
            }
        } catch(e) {}
    })();
    </script>
