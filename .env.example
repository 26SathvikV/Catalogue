# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE=mongodb+srv://<user>:<pass>@cluster.mongodb.net/catalogue

# ─── Session ──────────────────────────────────────────────────────────────────
SESSION_SECRET=change-me-to-something-long-and-random

# ─── App URL (no trailing slash) ──────────────────────────────────────────────
# Used for OAuth callbacks and Stripe redirect URLs.
# Leave blank or set to http://localhost:4000 for local dev.
SITE_URL=http://localhost:4000

# ─── Centralized Auth ─────────────────────────────────────────────────────────
# Set this in production to redirect /login and /signup to the home page.
# Leave blank in dev to use local auth.
AUTH_HOST=

# Shared secret for the SSO token handoff between home page and this app.
# Must match the value in the home page's .env.
SSO_SECRET=

# ─── Google OAuth (optional) ──────────────────────────────────────────────────
# Leave both blank to disable Google login without crashing.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Stripe (optional) ────────────────────────────────────────────────────────
# Leave blank to disable paid plans (Free plan still works).
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# From: stripe listen --forward-to localhost:4000/billing/webhook
STRIPE_WEBHOOK_SECRET=whsec_...

# Price IDs from your Stripe dashboard (Catalogue › Pro and Catalogue › Studio)
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_STUDIO=price_...

# ─── Collaborator invitation email (optional) ─────────────────────────────────
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=
